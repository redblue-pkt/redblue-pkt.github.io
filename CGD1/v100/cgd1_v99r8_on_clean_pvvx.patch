+static uint32_t set_cell(uint32_t common, uint32_t segment, char enabled)
+{
+	common &= 255;
+	segment &= 255;
+	uint32_t byte_index = segment >> 1;
+	uint32_t bit = (segment & 1) != 0 ? 3 - common : 7 - common;
+	uint32_t mask = 1u << bit;
+	volatile uint8_t *display_ram = cgd1_state.lcd;
+	uint8_t previous = display_ram[byte_index];
+	if (enabled != 0)
+	{
+		display_ram[byte_index] = previous | (uint8_t)mask;
+		return previous;
+	}
+	display_ram[byte_index] = previous & (uint8_t)~mask;
+	return mask;
+}
+
+const uint8_t cgd1_digit_glyphs[10] = {0x3f, 0x06, 0x5b, 0x4f, 0x66,
+											 0x6d, 0x7d, 0x07, 0x7f, 0x6f};
+static uint32_t draw_digit(uint32_t variant, uint32_t position, uint8_t digit)
+{
+	uint32_t segment;
+	uint32_t result = 0;
+	uint8_t mask = digit < 10 ? cgd1_digit_glyphs[digit] : 0;
+	position &= 0xff;
+	
+	for (segment = 0; segment < 7; segment++)
+	{
+		uint8_t bit = cgd1_digit_bits[variant][position][segment];
+		if (digit >= 10 || (mask & (1u << segment)) != 0)
+		{
+			result = set_cell(3 - (bit & 3), (bit >> 3) * 2 + ((bit & 7) < 4), digit < 10);
+		}
+	}
+	
+	return result;
+}
+
+void cgd1_lcd_set_cell(uint32_t common, uint32_t segment, char enabled)
+{
+	set_cell(common, segment, enabled);
+}
+uint32_t cgd1_lcd_draw_digit(uint32_t position, uint8_t digit)
+{
+	return draw_digit(cgd1_state.lcd_driver != 0, position & 255, digit);
+}
+
+uint32_t cgd1_lcd_show_weekday(uint8_t weekday, uint32_t language)
+{
+	uint32_t driver = cgd1_state.lcd_driver != 0;
+	language &= 255;
+	if (language > 3)
+	{
+		language = 2;
+	}
+	if (weekday > 6)
+	{
+		weekday = 7;
+	}
+	const struct cgd1_lcd_overlay *glyph = &cgd1_weekday_masks[driver][language][weekday];
+	uint32_t index;
+	for (index = 0; index < 4; index++)
+	{
+		static const uint8_t offsets[4] = {1, 2, 5, 6};
+		uint8_t offset = offsets[index];
+		cgd1_state.lcd[offset] =
+			(cgd1_state.lcd[offset] & glyph->and_mask[index]) | glyph->or_mask[index];
+	}
+	
+	return 0;
+}
+
+void cgd1_lcd_clear_date(char clear_extra_symbol)
+{
+	uint32_t index;
+	cgd1_lcd_set_cell(0, cgd1_state.lcd_driver == 0 ? 2 : 4, 0);
+	cgd1_lcd_set_cell(0, cgd1_state.lcd_driver == 0 ? 1 : 5, 0);
+	for (index = 0; index < 5; index++)
+	{
+		cgd1_lcd_draw_digit(index, 11);
+	}
+	if (clear_extra_symbol == 1)
+	{
+		cgd1_lcd_set_cell(1, cgd1_state.lcd_driver == 0 ? 2 : 4, 0);
+	}
+	cgd1_lcd_set_cell(0, cgd1_state.lcd_driver == 0 ? 6 : 0, 0);
+}
+void cgd1_lcd_show_date(uint32_t year, uint32_t month, uint32_t day, char clear_extra_symbol)
+{
+	uint32_t index;
+	year &= 255;
+	month &= 255;
+	day &= 255;
+	if (cgd1_state.date_hidden != 0)
+	{
+		cgd1_lcd_clear_date(clear_extra_symbol);
+		return;
+	}
+	if (clear_extra_symbol == 0)
+	{
+		cgd1_lcd_set_cell(1, cgd1_state.lcd_driver == 0 ? 2 : 4, 1);
+	}
+	for (index = 0; index < 5; index++)
+	{
+		cgd1_lcd_draw_digit(index, 11);
+	}
+	cgd1_lcd_draw_digit(0, year / 10);
+	cgd1_lcd_draw_digit(1, year % 10);
+	cgd1_lcd_set_cell(0, cgd1_state.lcd_driver == 0 ? 2 : 4, month < 10);
+	cgd1_lcd_set_cell(0, cgd1_state.lcd_driver == 0 ? 1 : 5, 1);
+	cgd1_lcd_set_cell(0, cgd1_state.lcd_driver == 0 ? 6 : 0, 1);
+	cgd1_lcd_draw_digit(2, month % 10);
+	cgd1_lcd_draw_digit(3, day / 10);
+	cgd1_lcd_draw_digit(4, day % 10);
+}
+
+uint32_t cgd1_lcd_show_time(uint32_t hour, uint32_t minute, char mode_24_hours)
+{
+	uint32_t index;
+	hour &= 255;
+	minute &= 255;
+	for (index = 5; index < 9; index++)
+	{
+		cgd1_lcd_draw_digit(index, 11);
+	}
+	if (mode_24_hours == 0)
+	{
+		cgd1_lcd_set_cell(0, 14, hour < 12);
+		cgd1_lcd_set_cell(3, 22, hour >= 12);
+		if (hour == 0 || hour == 12)
+		{
+			hour = 12;
+		}
+		else if (hour > 12)
+		{
+			hour -= 12;
+		}
+	}
+	else
+	{
+		cgd1_lcd_set_cell(0, 14, 0);
+		cgd1_lcd_set_cell(3, 22, 0);
+	}
+	cgd1_lcd_draw_digit(5, hour / 10);
+	cgd1_lcd_draw_digit(6, hour % 10);
+	cgd1_lcd_draw_digit(7, minute / 10);
+	return cgd1_lcd_draw_digit(8, minute % 10);
+}
+uint32_t cgd1_lcd_show_datetime(struct cgd1_rtc_time time, uint32_t language, uint8_t mode_24_hours)
+{
+	cgd1_state.displayed_time = time;
+	if (cgd1_state.date_hidden == 0)
+	{
+		cgd1_lcd_show_weekday(time.weekday, language & 255);
+		cgd1_lcd_show_date(time.year_since_2000 & 255, time.month, time.day, 0);
+		cgd1_lcd_show_time(time.hour, time.minute, mode_24_hours);
+		cgd1_lcd_set_cell(1, cgd1_state.lcd_driver == 0 ? 2 : 4, 1);
+		if (cgd1_state.lcd_driver == 0)
+		{
+			return set_cell(0, 6, 1);
+		}
+		return set_cell(0, 0, 1);
+	}
+	cgd1_lcd_show_weekday(7, 2);
+	cgd1_lcd_show_date(time.year_since_2000 & 255, time.month, time.day, 0);
+	return cgd1_lcd_show_time(time.hour, time.minute, mode_24_hours);
+}
+
+static void draw_error_e(uint8_t segment)
+{
+	set_cell(3, segment, 1);
+	set_cell(0, segment, 1);
+	set_cell(1, segment - 1, 1);
+	set_cell(2, segment - 1, 1);
+	set_cell(3, segment - 1, 1);
+}
+
+void cgd1_lcd_sensor_error_1(void)
+{
+	for (unsigned digit = 9; digit < 12; digit++)
+		cgd1_lcd_draw_digit(digit, 11);
+	set_cell(0, 23, 0);
+	draw_error_e(24);
+	cgd1_lcd_draw_digit(10, 1);
+	set_cell(0, 22, 0);
+	set_cell(0, 31, 1);
+	set_cell(0, 34, 1);
+}
+
+void cgd1_lcd_sensor_error_2(char celsius)
+{
+	for (unsigned digit = 9; digit < 15; digit++)
+		cgd1_lcd_draw_digit(digit, 11);
+	set_cell(0, 23, 0);
+	draw_error_e(24);
+	cgd1_lcd_draw_digit(10, 2);
+	draw_error_e(30);
+	cgd1_lcd_draw_digit(13, 2);
+	set_cell(0, 22, 0);
+	set_cell(0, 31, cgd1_state.lcd_driver != 0);
+	set_cell(0, 34, cgd1_state.lcd_driver == 0);
+	set_cell(0, 25, 1);
+	set_cell(0, 27, !celsius);
+	set_cell(0, 29, !!celsius);
+}
+
+void cgd1_lcd_clear_sensor_values(void)
+{
+	for (unsigned digit = 9; digit < 15; digit++)
+		cgd1_lcd_draw_digit(digit, 11);
+	set_cell(0, 23, 0);
+	set_cell(0, 22, 0);
+	set_cell(0, 31, 0);
+	set_cell(0, 34, 0);
+	set_cell(0, 25, 0);
+	set_cell(0, 27, 0);
+	set_cell(0, 29, 0);
+}
+
+void cgd1_lcd_show_sensor_values(int16_t temperature_tenths, uint16_t humidity_tenths,
+	uint8_t celsius, uint8_t force_refresh)
+{
+	int temperature_delta = temperature_tenths - (int)cgd1_state.last_temperature;
+	int humidity_delta = (int)humidity_tenths - (int)cgd1_state.last_humidity;
+	if (temperature_delta < 0)
+		temperature_delta = -temperature_delta;
+	if (humidity_delta < 0)
+		humidity_delta = -humidity_delta;
+	if (force_refresh || temperature_delta >= 2 || humidity_delta >= 10 || last_celsius != celsius) {
+		cgd1_state.display_temperature = temperature_tenths * 10;
+		cgd1_state.display_humidity = humidity_tenths * 10;
+		last_celsius = celsius;
+		cgd1_state.last_humidity = humidity_tenths;
+		cgd1_state.last_temperature = temperature_tenths;
+		for (unsigned digit = 9; digit < 15; digit++)
+			cgd1_lcd_draw_digit(digit, 11);
+		cgd1_lcd_set_cell(0, 23, 0);
+		cgd1_lcd_set_cell(0, 22, 1);
+		cgd1_lcd_set_cell(0, 31, 1);
+		cgd1_lcd_set_cell(0, 34, 1);
+		cgd1_lcd_set_cell(0, 25, 1);
+		cgd1_lcd_set_cell(0, 27, !celsius);
+		cgd1_lcd_set_cell(0, 29, !!celsius);
+		int temperature = celsius ? temperature_tenths : temperature_tenths * 9 / 5 + 320;
+		if (temperature < 0) {
+			cgd1_lcd_set_cell(2, 23, 1);
+			temperature = -temperature;
+		} else {
+			if (temperature > 999)
+				cgd1_lcd_set_cell(0, 23, 1);
+			cgd1_lcd_draw_digit(9, temperature % 1000 / 100);
+		}
+		cgd1_lcd_draw_digit(10, temperature % 100 / 10);
+		cgd1_lcd_draw_digit(11, temperature % 10);
+		if (humidity_tenths < 1000) {
+			cgd1_lcd_draw_digit(12, humidity_tenths / 100);
+			cgd1_lcd_draw_digit(13, humidity_tenths % 100 / 10);
+			cgd1_lcd_draw_digit(14, humidity_tenths % 10);
+		}
+	}
+	if ((uint16_t)(temperature_tenths + 99) > 598)
+		cgd1_lcd_sensor_error_1();
+}
+
+static void lcd_status_cell(unsigned bu9792_position, unsigned ht9b92_position, char enabled)
+{
+	if (cgd1_state.lcd_driver == 0)
+	{
+		set_cell(0, bu9792_position, enabled != 0);
+	}
+	else
+	{
+		set_cell(0, ht9b92_position, enabled != 0);
+	}
+}
+void cgd1_lcd_set_bell(char enabled)
+{
+	lcd_status_cell(4, 2, enabled);
+}
+
+void cgd1_lcd_set_bluetooth(char enabled)
+{
+	lcd_status_cell(7, 7, enabled);
+}
+
+void cgd1_lcd_show_invalid_time(void)
+{
+	unsigned driver = cgd1_state.lcd_driver != 0;
+	cgd1_lcd_show_weekday(7, 2);
+	for (unsigned position = 0; position < 9; position++)
+	{
+		cgd1_lcd_draw_digit(position, 11);
+		/* Segment G is the middle stroke of each numeric position. */
+		uint8_t bit = cgd1_digit_bits[driver][position][6];
+		set_cell(2, (bit >> 3) * 2 + ((bit & 7) < 4), 1);
+	}
+}
+
+void cgd1_lcd_colon_tick(uint16_t elapsed_ms)
+
+{
+	char screen;
+
+	screen = cgd1_ui_get_screen();
+	if (screen != '\x06')
+	{
+		if (cgd1_state.colon_enabled != '\0')
+		{
+			if (cgd1_state.colon_falling == '\0')
+			{
+				if ((uint16_t)(elapsed_ms + cgd1_state.colon_ms) < 1000)
+				{
+					cgd1_state.colon_ms = elapsed_ms + cgd1_state.colon_ms;
+					return;
+				}
+				cgd1_state.colon_ms = 1000;
+				cgd1_state.colon_falling = 1;
+				if (cgd1_state.lcd_driver == '\0')
+				{
+					set_cell(0, 0x12, '\0');
+					return;
+				}
+				set_cell(0, 0x12, '\0');
+				return;
+			}
+			if (elapsed_ms < cgd1_state.colon_ms)
+			{
+				cgd1_state.colon_ms = cgd1_state.colon_ms - elapsed_ms;
+				if (cgd1_state.colon_ms != 0)
+				{
+					return;
+				}
+			}
+			else
+			{
+				cgd1_state.colon_ms = 0;
+			}
+			cgd1_state.colon_falling = '\0';
+		}
+		if (cgd1_state.lcd_driver == '\0')
+		{
+			set_cell(0, 0x12, '\x01');
+		}
+		else
+		{
+			set_cell(0, 0x12, '\x01');
+		}
+	}
+	return;
+}
+
+void cgd1_lcd_update_bluetooth(void)
+
+{
+	if (cgd1_state.bluetooth_blink == '\0')
+	{
+		if ((cgd1_state.advertising == '\x01') ||
+			(controller_state == '\b'))
+		{
+			cgd1_lcd_set_bluetooth('\x01');
+		}
+		else
+		{
+			cgd1_lcd_set_bluetooth('\0');
+		}
+	}
+	return;
+}
+
+uint32_t cgd1_lcd_bluetooth_blink_tick(void)
+
+{
+	char mode;
+	uint32_t result;
+
+	if (cgd1_state.bluetooth_blink == '\0')
+	{
+		cgd1_power_unlock(1);
+		result = 0xffffffff;
+	}
+	else
+	{
+		mode = cgd1_ui_get_screen();
+		if (mode == '\x06')
+		{
+			result = 0xffffffff;
+		}
+		else if ((controller_state == '\b') && (3 < cgd1_state.bluetooth_count))
+		{
+			cgd1_lcd_set_bluetooth('\x01');
+			cgd1_display_flush();
+			cgd1_state.bluetooth_blink = '\0';
+			cgd1_power_unlock(1);
+			result = 0xffffffff;
+		}
+		else
+		{
+			if ((int)((uint32_t)cgd1_state.bluetooth_count << 0x1f) < 0)
+			{
+				cgd1_lcd_set_bluetooth('\x01');
+			}
+			else
+			{
+				cgd1_lcd_set_bluetooth('\0');
+			}
+			cgd1_display_flush();
+			mode = cgd1_state.bluetooth_mode;
+			cgd1_state.bluetooth_count = cgd1_state.bluetooth_count + 1;
+			if (cgd1_state.bluetooth_mode == '\0')
+			{
+				if (0x3b < cgd1_state.bluetooth_count)
+				{
+					cgd1_state.bluetooth_count = cgd1_state.bluetooth_mode;
+					cgd1_lcd_set_bluetooth('\0');
+					cgd1_display_flush();
+					cgd1_state.bluetooth_blink = mode;
+					cgd1_ble_set_binding_mode('\0');
+					cgd1_power_unlock(1);
+					return 0xffffffff;
+				}
+			}
+			else if ((cgd1_state.bluetooth_mode == '\x01') && (3 < cgd1_state.bluetooth_count))
+			{
+				cgd1_state.bluetooth_count = 0;
+				cgd1_lcd_set_bluetooth('\x01');
+				cgd1_display_flush();
+				cgd1_state.bluetooth_blink = 0;
+				cgd1_power_unlock(1);
+				return 0xffffffff;
+			}
+			cgd1_display_flush();
+			result = 0;
+		}
+	}
+	return result;
+}
+
+bool cgd1_lcd_binding_blink_start(void)
+
+{
+	bool started;
+
+	started = cgd1_state.bluetooth_blink == '\0';
+	if (started)
+	{
+		cgd1_state.bluetooth_blink = '\x01';
+		cgd1_state.bluetooth_count = 0;
+		cgd1_state.bluetooth_mode = 0;
+		cgd1_power_lock(1);
+		cgd1_lcd_bluetooth_blink_tick();
+		cgd1_soft_timer_add(cgd1_lcd_bluetooth_blink_tick, 500000);
+	}
+	return started;
+}
+
+bool cgd1_lcd_activity_blink_start(void)
+
+{
+	bool started;
+
+	started = cgd1_state.bluetooth_blink == '\0';
+	if (started)
+	{
+		cgd1_state.bluetooth_blink = '\x01';
+		cgd1_state.bluetooth_count = 0;
+		cgd1_state.bluetooth_mode = 1;
+		cgd1_power_lock(1);
+		cgd1_lcd_bluetooth_blink_tick();
+		cgd1_soft_timer_add(cgd1_lcd_bluetooth_blink_tick, 500000);
+	}
+	return started;
+}

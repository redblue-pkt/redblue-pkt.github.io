+static int hal_spi(void *ctx, const uint8_t *tx, size_t ntx,
+	uint8_t *rx, size_t nrx)
+{
+	size_t i;
+	volatile u8 discard;
+	int result = -1;
+	(void)ctx;
+	spi_master_gpio_set(SPI_GPIO_GROUP_B6B7D2D7);
+	spi_masterCSpin_select(GPIO_PD2);
+	spi_master_init(CLOCK_SYS_CLOCK_HZ / 4000000 / 2 - 1, SPI_MODE0);
+	gpio_write(GPIO_PD2, 0);
+	reg_spi_ctrl &= ~(FLD_SPI_RD | FLD_SPI_DATA_OUT_DIS);
+	for (i = 0; i < ntx; i++) {
+		reg_spi_data = tx[i];
+		if (spi_wait_ready())
+			goto complete;
+	}
+	if (nrx) {
+		reg_spi_ctrl |= FLD_SPI_DATA_OUT_DIS | FLD_SPI_RD;
+		discard = reg_spi_data;
+		(void)discard;
+		if (spi_wait_ready())
+			goto complete;
+		for (i = 0; i < nrx; i++) {
+			rx[i] = reg_spi_data;
+			if (spi_wait_ready())
+				goto complete;
+		}
+	}
+	result = 0;

+
+		int16 isf_hist[M * DTX_HIST_SIZE];
+		int16 log_en_hist[DTX_HIST_SIZE];
+		int16 hist_ptr;
+
+		int16 dtxHangoverCount;
+		int16 decAnaElapsedCount;
+
+		int16 sid_frame;
+		int16 valid_data;
+		int16 dtxHangoverAdded;
+

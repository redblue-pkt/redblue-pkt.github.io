+void cgd1_button_debounce_poll(void)
+
+{
+	uint8_t pins;
+
+	if (cgd1_state.button.scanning != '\0')
+	{
+		pins = (cgd1_hw_button() ? 2 : 0);
+		cgd1_state.button.sampled_level = pins & 2;
+		if ((pins & 2) == 0)
+		{
+			if (cgd1_state.button.previous_sample == 0)
+			{
+				cgd1_button_update_state('\0');
+				cgd1_state.button.previous_sample = cgd1_state.button.sampled_level;
+			}
+			else
+			{
+				cgd1_state.button.previous_sample = 0;
+			}
+		}
+		else
+		{
+			cgd1_state.button.sampled_level = 1;
+			if (cgd1_state.button.previous_sample == 1)
+			{
+				cgd1_button_update_state('\x01');
+				cgd1_state.button.previous_sample = cgd1_state.button.sampled_level;
+			}
+			else
+			{
+				cgd1_state.button.previous_sample = 1;
+			}
+		}

+/* Copyright (c) 2026, sakumisu. SPDX-License-Identifier: Apache-2.0
+ * Minimal mono decoder extracted from CherryAVP, commit
+ * 9829ff858aa3a3a1fb6706d598f6ca658f4b4e6a. No framework dependency. */
+#include "libadpcm.h"
+#if defined(DECODER_ADPCM)
+typedef char decoder_state_fits[(sizeof(struct adpcm_state) <= 16) ? 1 : -1];
+static const int8_t adpcm_ima_index_table[16] = {
+	-1, -1, -1, -1, 2, 4, 6, 8,
+	-1, -1, -1, -1, 2, 4, 6, 8
+};
+
+static const int16_t adpcm_ima_step_table[89] = {
+	7, 8, 9, 10, 11, 12, 13, 14,
+	16, 17, 19, 21, 23, 25, 28, 31,
+	34, 37, 41, 45, 50, 55, 60, 66,
+	73, 80, 88, 97, 107, 118, 130, 143,
+	157, 173, 190, 209, 230, 253, 279, 307,
+	337, 371, 408, 449, 494, 544, 598, 658,
+	724, 796, 876, 963, 1060, 1166, 1282, 1411,
+	1552, 1707, 1878, 2066, 2272, 2499, 2749, 3024,
+	3327, 3660, 4026, 4428, 4871, 5358, 5894, 6484,
+	7132, 7845, 8630, 9493, 10442, 11487, 12635, 13899,
+	15289, 16818, 18500, 20350, 22385, 24623, 27086, 29794,
+	32767
+};
+
+static int16_t adpcm_ima_decode_nibble(struct adpcm_state *state,
+									   uint8_t nibble, uint8_t legacy)
+{
+	int32_t step;
+	int32_t diff;
+
+	step = adpcm_ima_step_table[state->index];
+	diff = step >> 3;
+
+	if ((nibble & 1u) != 0u) {
+		diff += step >> 2;
+	}
+	if ((nibble & 2u) != 0u) {
+		diff += step >> 1;
+	}
+	if ((nibble & 4u) != 0u) {
+		diff += step;
+	}
+
+	if (legacy) {
+		diff = ((2 * (nibble & 7) + 1) * step) >> 3;
+	}
+
+	if ((nibble & 8u) != 0u) {
+		state->predictor -= diff;
+	} else {
+		state->predictor += diff;
+	}
+
+	if (state->predictor > 32767) {
+		state->predictor = 32767;
+	} else if (state->predictor < -32768) {
+		state->predictor = -32768;
+	}
+
+	state->index += adpcm_ima_index_table[nibble & 0x0fu];
+	if (state->index < 0) {
+		state->index = 0;
+	} else if (state->index > 88) {
+		state->index = 88;
+	}
+
+	return (int16_t)state->predictor;
+}
+
+int DECODER_RAM libadpcm_decode(struct decoder_frame *f)
+{
+	if (!f)
+		return -1;
+	if (f->input_size && !f->input)
+		return -1;
+	if (!(f->flags & (DECODER_INIT | DECODER_PROBE)) && (!f->input || !f->output))
+		return -1;
+	struct adpcm_state *state = f->state;
+	if (f->codec != AUDIO_IMA)
+		return f->flags & DECODER_PROBE ? 0 : -1;
+	if (f->channels != 1 || f->rate < 4000 || f->rate > DECODER_MAX_RATE)
+		return -1;
+	if (f->flags & DECODER_PROBE)
+		return 1;
+	if (!state)
+		return -1;
+	if (f->flags & DECODER_INIT) {
+		memset(state, 0, sizeof(*state));
+		return 1;
+	}
+	if (state->index < 0 || state->index > 88)
+		return -1;
+	f->input_used = f->output_used = 0;
+	while (f->output_used < f->output_size) {
+		uint8_t code;
+		if (state->high) {
+			code = state->packed >> 4;
+			state->high = 0;
+		} else {
+			if (f->input_used == f->input_size)
+				break;
+			state->packed = f->input[f->input_used++];
+			code = state->packed & 15;
+			state->high = 1;
+		}
+		f->output[f->output_used++] = adpcm_ima_decode_nibble(state, code,
+			f->flags & DECODER_LEGACY_IMA);
+	}
+	return f->output_used ? 0 : -2;
+}
+#endif

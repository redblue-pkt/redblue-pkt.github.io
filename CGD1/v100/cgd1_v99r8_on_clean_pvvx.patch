+static uint32_t active_event_count(void)
+{
+	uint32_t index;
+	uint32_t count = 0;
+	for (index = 0; index < 16; index++)
+	{
+		count += cgd1_state.alarms.events[index].enabled == 1;
+	}
+	return count;
+}
+
+uint32_t cgd1_alarm_add_event(char slot, uint8_t event_type)
+{
+	uint32_t index;
+	uint32_t free_index = 255;
+	uint32_t selected = 255;
+	for (index = 0; index < 16; index++)
+	{
+		volatile struct cgd1_alarm_event *event = &cgd1_state.alarms.events[index];
+		if (event->enabled != 1)
+		{
+			free_index = index;
+		}
+		if (event->slot == (uint8_t)slot)
+		{
+			selected = index;
+			break;
+		}
+	}
+	if (selected == 255)
+	{
+		selected = free_index;
+	}
+	volatile struct cgd1_alarm_event *event = &cgd1_state.alarms.events[selected];
+	event->slot = slot;
+	event->event_type = event_type;
+	event->enabled = 1;
+	event->timestamp = 0;
+	return 0;
+}
+
+uint8_t cgd1_alarm_valid_slot_count(struct cgd1_alarm_slot *filter_slots, uint8_t enabled_only)
+{
+	uint32_t index;
+	uint8_t count = 0;
+	for (index = 0; index < 16; index++)
+	{
+		volatile struct cgd1_alarm_slot *slot = &cgd1_state.alarms.slots[index];
+		if (slot->enabled != 255 && slot->hour < 24 && slot->minute < 60 &&
+			(enabled_only == 0 || filter_slots[index].enabled == 1))
+		{
+			count++;
+		}
+	}
+	return count;
+}
+
+void cgd1_alarm_evaluate_minute(struct cgd1_rtc_time *now)
+{
+	uint32_t index;
+	uint32_t eligible = 0;
+	if (cgd1_ui_get_screen() == 6)
+	{
+		return;
+	}
+	if (cgd1_board_uses_at8372())
+	{
+		if (cgd1_state.rtc_init_retries == 1)
+		{
+			cgd1_alarm_expire_entries();
+		}
+		else if (cgd1_state.rtc_init_retries > 1)
+		{
+			return;
+		}
+	}
+	if (cgd1_state.minute == now->minute)
+	{
+		if (cgd1_state.minute_repeated != 0)
+		{
+			return;
+		}
+	}
+	else
+	{
+		cgd1_state.minute_repeated = 0;
+		cgd1_state.minute = now->minute;
+	}
+	if (cgd1_state.config.alarms_all_off != 0 ||
+		(cgd1_alarm_valid_slot_count((struct cgd1_alarm_slot *)cgd1_state.alarms.slots, 1) == 0 &&
+		 active_event_count() == 0))
+	{
+		cgd1_lcd_set_bell(0);
+		return;
+	}
+	for (index = 0; index < 16; index++)
+	{
+		volatile struct cgd1_alarm_slot *slot = &cgd1_state.alarms.slots[index];
+		if (slot->enabled != 1 || slot->hour >= 24 || slot->minute >= 60)
+		{
+			continue;
+		}
+		eligible++;
+		uint32_t weekday = cgd1_weekday_monday_one(now->weekday);
+		if (slot->repeat_raw != 0 && ((slot->repeat_raw >> (weekday - 1)) & 1u) == 0)
+		{
+			continue;
+		}
+		if (slot->hour != now->hour || slot->minute != now->minute)
+		{
+			continue;
+		}
+		if (slot->repeat_raw != 0)
+		{
+			slot->timestamp = cgd1_app_epoch();
+		}
+		bool may_start = (slot->flags_raw & 1) != 0 || (cgd1_alarm_count_snoozable_ringing() == 0 &&
+														cgd1_alarm_count_event_type2() == 0);
+		if (!may_start)
+		{
+			if (slot->repeat_raw == 0)
+			{
+				cgd1_alarm_disable_slot(index);
+			}
+			continue;
+		}
+		cgd1_alarm_add_event(index, CGD1_ALARM_RINGING);
+		bool snoozable_active =
+			cgd1_alarm_count_snoozable_ringing() != 0 || cgd1_alarm_count_event_type2() != 0;
+		cgd1_on_alarm_triggered(index, snoozable_active);
+	}
+	if (active_event_count() != 0)
+	{
+		for (index = 0; index < 16; index++)
+		{
+			volatile struct cgd1_alarm_event *event = &cgd1_state.alarms.events[index];
+			if (event->enabled != 1 || event->event_type != CGD1_ALARM_SNOOZED)
+			{
+				continue;
+			}
+			eligible++;
+			struct cgd1_calendar scheduled;
+			cgd1_epoch_to_calendar(event->timestamp, &scheduled);
+			if (now->hour == scheduled.hour && now->minute == scheduled.minute)
+			{
+				uint32_t candidate;
+				for (candidate = 0; candidate < 16; candidate++)
+				{
+					if (cgd1_state.alarms.events[candidate].slot == event->slot)
+					{
+						cgd1_state.alarms.events[candidate].event_type = CGD1_ALARM_RINGING_AFTER_SNOOZE;
+						break;
+					}
+				}
+				cgd1_on_alarm_triggered(event->slot, 0);
+			}
+		}
+	}
+	cgd1_lcd_set_bell(eligible != 0);
+}
+
+void cgd1_alarm_clear_ringing_events(void)
+{
+	uint32_t index;
+	for (index = 0; index < 16; index++)
+	{
+		volatile struct cgd1_alarm_event *event = &cgd1_state.alarms.events[index];
+		if (event->event_type == CGD1_ALARM_RINGING ||
+			event->event_type == CGD1_ALARM_RINGING_AFTER_SNOOZE)
+		{
+			event->enabled = 0;
+		}
+	}
+}
+static bool snooze_event(volatile struct cgd1_alarm_event *event)
+{
+	volatile struct cgd1_alarm_slot *slot = &cgd1_state.alarms.slots[event->slot];
+	if (event->timestamp == 0)
+	{
+		event->timestamp = slot->timestamp;
+		if (event->timestamp == 0)
+		{
+
+			return false;
+		}
+	}
+
+	event->timestamp += 600;
+	event->event_type = CGD1_ALARM_SNOOZED;
+	cgd1_ui_show_snooze_wait();
+	return true;
+}
+
+void cgd1_alarm_snooze(int16_t selection)
+{
+	uint32_t index;
+	if (cgd1_state.config.alarms_all_off != 0)
+	{
+
+		return;
+	}
+	if (selection < 0)
+	{
+		for (index = 0; index < 16; index++)
+		{
+			volatile struct cgd1_alarm_event *event = &cgd1_state.alarms.events[index];
+			volatile struct cgd1_alarm_slot *slot = &cgd1_state.alarms.slots[event->slot];
+			if (event->enabled == 1 && (slot->flags_raw & 1) != 0 && slot->enabled == 1)
+			{
+				snooze_event(event);
+			}
+		}
+		return;
+	}
+	if (cgd1_state.alarms.events[(uint32_t)selection].enabled != 1)
+	{
+
+		return;
+	}
+	uint8_t slot_index = (uint8_t)selection;
+	if ((cgd1_state.alarms.slots[slot_index].flags_raw & 1) == 0)
+	{
+
+		return;
+	}
+	for (index = 0; index < 16; index++)
+	{
+		volatile struct cgd1_alarm_event *event = &cgd1_state.alarms.events[index];
+		if (event->slot == slot_index && event->enabled == 1)
+		{
+			snooze_event(event);
+			return;
+		}
+	}
+
+}
+
+uint32_t cgd1_alarm_stop_non_snoozable(void)
+{
+	uint32_t index;
+	uint32_t changed = 0;
+	for (index = 0; index < 16; index++)
+	{
+		volatile struct cgd1_alarm_event *event = &cgd1_state.alarms.events[index];
+		if (event->enabled != 1 || event->event_type != CGD1_ALARM_RINGING)
+		{
+			continue;
+		}
+		volatile struct cgd1_alarm_slot *slot = &cgd1_state.alarms.slots[event->slot];
+		if (slot->enabled == 1 && (slot->flags_raw & 1) == 0)
+		{
+			event->enabled = 0;
+			if (slot->repeat_raw == 0)
+			{
+				slot->enabled = 0;
+				changed = 1;
+			}
+		}
+	}
+	return changed;
+}
+
+uint32_t cgd1_alarm_stop_events(char preserve_snoozable)
+{
+	uint32_t index;
+	uint32_t result = 0;
+	for (index = 0; index < 16; index++)
+	{
+		volatile struct cgd1_alarm_event *event = &cgd1_state.alarms.events[index];
+		if (event->enabled != 1 || (event->event_type != 0 && event->event_type != 2))
+		{
+			continue;
+		}
+		volatile struct cgd1_alarm_slot *slot = &cgd1_state.alarms.slots[event->slot];
+		if (slot->enabled != 1 || (preserve_snoozable != 0 && (slot->flags_raw & 1) != 0))
+		{
+			continue;
+		}
+		event->enabled = 0;
+		if (slot->repeat_raw == 0)
+		{
+			slot->enabled = 0;
+			result = 1;
+		}
+		else
+		{
+			result = 2;
+		}
+	}
+	return result;
+}
+
+uint32_t cgd1_alarm_disable_active_slots(char non_snoozable_only)
+{
+	uint32_t index;
+	uint32_t changed = 0;
+	for (index = 0; index < 16; index++)
+	{
+		volatile struct cgd1_alarm_event *event = &cgd1_state.alarms.events[index];
+		if (event->enabled != 1)
+		{
+			continue;
+		}
+		volatile struct cgd1_alarm_slot *slot = &cgd1_state.alarms.slots[event->slot];
+		if (slot->enabled != 1)
+		{
+			continue;
+		}
+		if (non_snoozable_only != 0)
+		{
+			if ((slot->flags_raw & 1) != 0 || slot->repeat_raw != 0)
+			{
+				continue;
+			}
+		}
+		else if (slot->repeat_raw != 0)
+		{
+			if ((slot->flags_raw & 1) != 0)
+			{
+
+				event->enabled = 0;
+			}
+			continue;
+		}
+		event->enabled = 0;
+		slot->enabled = 0;
+		changed = 1;
+	}
+	return changed;
+}

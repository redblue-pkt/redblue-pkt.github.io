+------------------------------------------------------------------------------
+ REVISION HISTORY
+
+
+ Description:
+
+------------------------------------------------------------------------------
+ INPUT AND OUTPUT DEFINITIONS
+
+	 int16 gain_code,               (i) Q0  : gain of code
+	 int16 gain_pit,                (i) Q14 : gain of pitch
+	 int16 code[],                  (i/o)   : code vector
+	 int16 mode,                    (i)     : level, 0=hi, 1=lo, 2=off
+	 int16 disp_mem[],              (i/o)   : static memory (size = 8)
+	 int16 ScratchMem[]

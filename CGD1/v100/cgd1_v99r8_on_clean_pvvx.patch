+uint8_t cgd1_led_get_brightness(void)
+{
+	unsigned now = cgd1_state.time.hour * 60 + cgd1_state.time.minute;
+	unsigned start = cgd1_state.config.night_start_hour * 60 + cgd1_state.config.night_start_minute;
+	unsigned end = cgd1_state.config.night_end_hour * 60 + cgd1_state.config.night_end_minute;
+	bool night = start == end || (start < end ? now >= start && now < end : now >= start || now < end);
+	uint8_t level = night ? cgd1_state.config.led_brightness & 15 : cgd1_state.config.led_brightness >> 4;
+	return level > 10 ? 10 : level;
+}

+static AUDIO_RAM int refill(struct cgd1_audio_decoder *d);
+/* Framed formats identify themselves. Raw PCM/IMA/G.711 require metadata. */
+static int open_framed(struct cgd1_audio_decoder *d, unsigned codec)
+{
+	struct decoder_frame f;
+	memset(&f, 0, sizeof(f));
+	f.codec = codec;
+	f.channels = 1;
+	f.flags = DECODER_PROBE;
+	d->frames = 0;
+	d->offset = 0;
+	while (d->offset < d->size) {
+		int count = refill(d);
+		if (count <= 0)
+			return -1;
+		f.input = d->cache + d->offset - d->cache_offset;
+		f.input_size = count;
+		f.input_used = f.output_used = 0;
+		int result = decode_frame(&f);
+		if (result == -2 && d->offset > d->cache_offset) {
+			d->cache_size = 0;
+			continue;
+		}
+		if (result != 1 || !f.input_used || f.input_used > (unsigned)count)
+			return -1;
+		d->offset += f.input_used;
+		d->frames += f.output_used;
+	}

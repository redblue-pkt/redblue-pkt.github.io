+	return;
+}
+
+void cgd1_button_scan_task(void)
+
+{
+	int tick;
+
+	tick = cgd1_hw_tick();
+	if (480000 < (uint32_t)(tick - cgd1_state.button.scan_timestamp))
+	{
+		cgd1_state.button.scan_timestamp = cgd1_hw_tick();
+		cgd1_button_debounce_poll();
+	}
+	return;
+}

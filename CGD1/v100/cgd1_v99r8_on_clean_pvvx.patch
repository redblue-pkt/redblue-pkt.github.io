+void cgd1_alarm_show_next(char mode)
+{
+	uint8_t requested = (uint8_t)mode;
+	uint8_t previous = cgd1_state.next_mode;
+	uint32_t now;
+
+	if (requested == previous)
+	{
+		if (cgd1_state.next_valid != 0)
+		{
+			cgd1_lcd_show_datetime(*(&cgd1_state.next_alarm), cgd1_state.config.chinese_language, cgd1_state.config.hour_system_24);
+			cgd1_ui_show_next_alarm();
+		}
+		return;
+	}
+	if (requested == 1 && previous == 0)
+	{
+		cgd1_state.next_valid = previous;
+		memset((&cgd1_state.next_alarm), 0, sizeof(*(&cgd1_state.next_alarm)));
+	}
+	else if (requested == 0 && previous == 1)
+	{
+		cgd1_lcd_colon_blink_enable();
+	}
+	cgd1_state.next_mode = requested;
+
+	if (requested == 0)
+	{
+		if (cgd1_alarm_count_event_type1() == 0)
+		{
+			cgd1_ui_show_clock();
+		}
+		else
+		{
+			cgd1_ui_show_snooze_wait();
+		}
+		cgd1_display_flush();
+		return;
+	}
+	now = cgd1_app_epoch();
+	if (cgd1_alarm_get_next((uint8_t *)(&cgd1_state.next_alarm), now, 0))
+	{
+		cgd1_lcd_colon_blink_disable();
+
+		cgd1_state.next_valid = 1;
+	}
+	else
+	{
+
+		cgd1_state.next_valid = 0;
+	}
+}

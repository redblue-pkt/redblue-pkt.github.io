+void cgd1_lcd_snooze_label(uint8_t enabled, uint8_t language)
+{
+	if (language != 0 && language != 1 && language != 3)
+		return;
+	cgd1_lcd_set_cell(2, 22, enabled && (language & 1));
+	cgd1_lcd_set_cell(0, 20, enabled && language != 1);
+}
+
+void cgd1_lcd_stop_label(uint8_t enabled, uint8_t language)
+{
+	if (language != 0 && language != 1 && language != 3)
+		return;
+	cgd1_lcd_set_cell(1, 22, enabled && (language & 1));
+	cgd1_lcd_set_cell(0, 16, enabled && language != 1);
+}
+
+void cgd1_lcd_hide_sensor_values(char flush)
+
+{
+	if (cgd1_state.sensors_hidden == '\0')
+	{
+		cgd1_lcd_clear_sensor_values();
+		cgd1_state.sensors_hidden = '\x01';
+		if (flush != '\0')
+		{
+			cgd1_display_flush();
+		}
+	}
+	return;
+}
+
+void cgd1_lcd_restore_sensor_values(char flush)
+
+{
+	int temperature;
+	uint32_t humidity;
+
+	if (cgd1_state.sensors_hidden != '\0')
+	{
+		cgd1_state.sensors_hidden = '\0';
+		temperature = (((int)((uint16_t)cgd1_state.raw_temperature)) / (10));
+		humidity = (((uint32_t)cgd1_state.raw_humidity) / (10));
+		cgd1_lcd_show_sensor_values((int16_t)temperature, (uint16_t)humidity, cgd1_state.config.celsius, '\x01');
+		if (flush != '\0')
+		{
+			cgd1_display_flush();
+		}
+	}
+	return;
+}
+
+void cgd1_lcd_hide_date(char flush, char clear_symbol)
+{
+	if (!cgd1_state.date_hidden)
+	{
+		cgd1_lcd_clear_date(clear_symbol);
+		cgd1_lcd_show_weekday(7, 2);
+		cgd1_state.date_hidden = 1;
+		if (flush)
+			cgd1_display_flush();
+	}
+}
+
+uint32_t cgd1_lcd_restore_date(char flush, char show_symbol)
+
+{
+	uint32_t result;
+
+	result = (uint32_t)flush;
+	if (cgd1_state.date_hidden != '\0')
+	{
+		cgd1_state.date_hidden = '\0';
+		cgd1_lcd_show_date((uint32_t)((uint8_t)cgd1_state.displayed_time.year_since_2000),
+						   (uint32_t)cgd1_state.displayed_time.month,
+						   (uint32_t)cgd1_state.displayed_time.day, show_symbol);
+		result = cgd1_lcd_show_weekday(cgd1_state.displayed_time.weekday,
+									  (uint32_t)cgd1_state.config.chinese_language);
+		if (flush != '\0')
+		{
+			result = cgd1_display_flush();
+		}
+	}
+	return result;
+}

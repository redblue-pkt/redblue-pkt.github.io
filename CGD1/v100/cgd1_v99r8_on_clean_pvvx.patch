+		return result;
+	}
+
+	static inline Word32 amrnb_fxp_msu_16_by_16bb(Word32 L_var1, Word32 L_var2, Word32 L_var3)
+	{
+		Word32 result;
+
+		result = L_var3 - L_var1 * L_var2;
+
+		return result;
+	}

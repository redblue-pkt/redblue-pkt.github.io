+/* Copyright (c) 2026 sakumisu; Copyright (C) 2009 Martin Storsjo.
+ * SPDX-License-Identifier: Apache-2.0. CherryAVP/OpenCORE decoder only. */
+#include "libamr.h"
+#if defined(DECODER_AMR)
+void *amr_nb_init(void);
+void *amr_wb_init(void);
+void amr_nb_decode(void *, const unsigned char *, short *, int);
+void amr_wb_decode(void *, const unsigned char *, short *, int);
+static uint32_t arena[4096];
+static unsigned arena_used;
+static void *active_decoder;
+static uint32_t active_rate;
+void *amr_alloc(size_t size)
+{
+	unsigned words = (size + 3) / 4;
+	if (words > sizeof(arena) / sizeof(arena[0]) - arena_used)
+		return NULL;
+	void *pointer = arena + arena_used;
+	arena_used += words;
+	return pointer;
+}
+void amr_free(void *pointer)
+{
+	(void)pointer;
+}
+int libamr_decode(struct decoder_frame *f)
+{
+	if (!f)
+		return -1;
+	if (f->input_size && !f->input)
+		return -1;
+	if (!(f->flags & (DECODER_INIT | DECODER_PROBE)) && (!f->input || !f->output))
+		return -1;
+	static const uint8_t nb[16] = {12,13,15,17,19,20,26,31,5,255,255,255,255,255,0,0};
+	static const uint8_t wb[16] = {17,23,32,36,40,46,50,58,60,5,255,255,255,255,0,0};
+	if (f->codec != AUDIO_AMR)
+		return f->flags & DECODER_PROBE ? 0 : -1;
+	if (!f->rate && !((f->flags & DECODER_PROBE) && f->input_size))
+		return -1;
+	if (f->channels != 1 || (f->rate && f->rate != 8000 && f->rate != 16000))
+		return -1;
+	if (f->flags & DECODER_PROBE) {
+		if (!f->input_size)
+			return f->rate ? 1 : -1;
+		if (f->input_size >= 9 && !memcmp(f->input, "#!AMR-WB\n", 9)) {
+			f->rate = 16000;
+			f->input_used = 9;
+			return 1;
+		}
+		if (f->input_size >= 6 && !memcmp(f->input, "#!AMR\n", 6)) {
+			f->rate = 8000;
+			f->input_used = 6;
+			return 1;
+		}
+		if (!f->rate)
+			return -1;
+		unsigned type = (f->input[0] >> 3) & 15;
+		unsigned length = f->rate == 8000 ? nb[type] : wb[type];
+		if ((f->input[0] & 0x83) || length == 255)
+			return -1;
+		if (f->input_size < length + 1)
+			return -2;
+		f->input_used = length + 1;
+		f->output_used = f->rate / 50;
+		return 1;
+	}
+	if (f->flags & DECODER_INIT) {
+		arena_used = 0;
+		active_decoder = f->rate == 8000 ? amr_nb_init() : amr_wb_init();
+		active_rate = f->rate;
+		return active_decoder ? 1 : -1;
+	}
+	f->input_used = f->output_used = 0;
+	if (!active_decoder || active_rate != f->rate)
+		return -1;
+	if (!f->input_size)
+		return -2;
+	uint8_t toc = f->input[0], type = (toc >> 3) & 15;
+	unsigned length = f->rate == 8000 ? nb[type] : wb[type];
+	if ((toc & 0x83) || length == 255)
+		return -1;
+	unsigned samples = f->rate / 50;
+	if (f->input_size < length + 1 || f->output_size < samples)
+		return -2;
+	if (f->rate == 8000)
+		amr_nb_decode(active_decoder, f->input, f->output, !(toc & 4));
+	else
+		amr_wb_decode(active_decoder, f->input, f->output, !(toc & 4));
+	f->input_used = length + 1;
+	f->output_used = samples;
+	return 0;
+}
+#endif
+#if defined(DECODER_AMR) && defined(CGD1_TELINK)
+/* TC32 SDK lacks these two C runtime operations. */
+void *amr_memmove(void *target, const void *source, size_t size)
+{
+	uint8_t *out = target;
+	const uint8_t *in = source;
+	if ((uintptr_t)out < (uintptr_t)in) {
+		while (size--)
+			*out++ = *in++;
+	} else {
+		out += size;
+		in += size;
+		while (size--)
+			*--out = *--in;
+	}
+	return target;
+}
+uint64_t __muldi3(uint64_t left, uint64_t right)
+{
+	union words {
+		uint64_t value;
+		struct {
+			uint32_t low, high;
+		} half;
+	} a, b, result;
+	a.value = left;
+	b.value = right;
+	uint32_t a0 = a.half.low & 65535, a1 = a.half.low >> 16;
+	uint32_t b0 = b.half.low & 65535, b1 = b.half.low >> 16;
+	uint32_t p0 = a0 * b0, p1 = a1 * b0, p2 = a0 * b1;
+	uint32_t carry = (p0 >> 16) + (p1 & 65535) + (p2 & 65535);
+	result.half.low = (p0 & 65535) | (carry << 16);
+	result.half.high = a1 * b1 + (p1 >> 16) + (p2 >> 16) + (carry >> 16)
+		+ a.half.low * b.half.high + a.half.high * b.half.low;
+	return result.value;
+}
+#endif

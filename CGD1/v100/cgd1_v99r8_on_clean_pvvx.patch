+----------------------------------------------------------------------------*/
+
+/*----------------------------------------------------------------------------
+; FUNCTION CODE
+----------------------------------------------------------------------------*/
+
+void dec_acelp_2p_in_64(
+	int16 index,        /* (i):   12 bits index                          */
+	int16 code[]        /* (o): Q9 algebraic (fixed) codebook excitation */
+)
+{
+	int16 i;
+
+	pv_memset(code, 0, L_CODE*sizeof(*code));
+
+	/* decode the positions and signs of pulses and build the codeword */
+
+	i = (index >> 5) & 0x003E;
+
+	if (((index >> 6) & NB_POS) == 0)
+	{
+		code[i] = 512;
+	}
+	else
+	{
+		code[i] = -512;
+	}
+
+	i = ((index & 0x001F) << 1) + 1;
+
+	if ((index & NB_POS) == 0)
+	{
+		code[i] = 512;
+	}
+	else
+	{
+		code[i] = -512;
+	}
+
+}
+

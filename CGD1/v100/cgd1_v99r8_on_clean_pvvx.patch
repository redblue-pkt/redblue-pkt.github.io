+#if DEVICE_TYPE == DEVICE_CGD1
+/* A slave can retain a partial transaction across a short battery removal. */
+void cgd1_i2c_recover(void)
+{
+	unsigned i;
+	reg_rst0 = FLD_RST0_I2C;
+	reg_rst0 = 0;
+	gpio_set_func(I2C_SDA, AS_GPIO);
+	gpio_set_func(I2C_SCL, AS_GPIO);
+	gpio_write(I2C_SDA, 0);
+	gpio_write(I2C_SCL, 0);
+	gpio_set_output_en(I2C_SDA, 0);
+	gpio_set_output_en(I2C_SCL, 0);
+	for (i = 0; i < 9; i++) {
+		gpio_set_output_en(I2C_SCL, 1);
+		sleep_us(5);
+		gpio_set_output_en(I2C_SCL, 0);
+		sleep_us(5);
+	}
+	/* Open-drain STOP; never drive either bus line high. */
+	gpio_set_output_en(I2C_SCL, 1);
+	gpio_set_output_en(I2C_SDA, 1);
+	sleep_us(5);
+	gpio_set_output_en(I2C_SCL, 0);
+	sleep_us(5);
+	gpio_set_output_en(I2C_SDA, 0);
+	sleep_us(5);
+	init_i2c();
+}
+static int i2c_wait_ready(void)
+{
+	u32 start = clock_time();
+	while (reg_i2c_status & FLD_I2C_CMD_BUSY) {
+		if (clock_time_exceed(start, 2000)) {
+			cgd1_i2c_recover();
+			return 1;
+		}
+	}
+	return 0;
+}

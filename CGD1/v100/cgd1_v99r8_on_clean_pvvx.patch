+	gpio_write(GPIO_PD2, 1);
+	/* SPI and I2C share the controller; restore it on success AND timeout. */
+	reg_rst0 = FLD_RST0_I2C;
+	reg_rst0 = 0;
+	init_i2c();
+	return result;

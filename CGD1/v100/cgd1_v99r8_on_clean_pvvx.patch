+Word32 L_abs (Word32 L_var1)
+{
+	Word32 L_var_out;
+
+	if (L_var1 == MIN_32)
+	{
+		L_var_out = MAX_32;
+	}
+	else
+	{
+		if (L_var1 < 0)

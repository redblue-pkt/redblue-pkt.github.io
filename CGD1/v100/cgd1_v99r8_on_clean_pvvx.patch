+
+{
+	if (cgd1_state.screen_locked == '\0')
+	{
+		cgd1_state.screen = 2;
+		cgd1_lcd_snooze_label('\0', '\x03');
+		cgd1_lcd_stop_label('\0', '\x03');
+		cgd1_lcd_restore_sensor_values('\0');
+		cgd1_lcd_restore_date('\x01', '\0');
+	}
+	return;

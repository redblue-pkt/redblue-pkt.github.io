+			if (d->codec == AUDIO_IMA) {
+				if (d->frames / 2 + (d->frames & 1) != bytes)
+					return -1;
+			} else if (d->codec == AUDIO_G722) {
+				if (d->frames != bytes && d->frames != bytes * 2u)
+					return -1;
+				/* Standard G.722 always reconstructs 16 kHz PCM. */
+				d->rate = 16000;
+				d->frames = bytes * 2u;
+			} else if (d->codec <= AUDIO_ULAW) {
+				if (d->frames > bytes / width || d->frames * width != bytes)
+					return -1;
+			}
+			d->offset = sizeof(h);
+		}
+	}
+	d->data_offset = d->offset;
+	return cgd1_audio_rewind(d);
+}
+AUDIO_RAM int cgd1_audio_rewind(struct cgd1_audio_decoder *d)
+{
+	d->offset = d->data_offset;
+	d->frame = d->cache_size = d->pcm_pos = d->pcm_count = 0;
+	struct decoder_frame f;
+	memset(&f, 0, sizeof(f));
+	f.codec = d->codec;
+	f.rate = d->rate;
+	f.channels = 1;
+	f.state = d->state;
+	f.flags = DECODER_INIT | DECODER_LEGACY_IMA;
+	return decode_frame(&f) == 1 ? 0 : -1;
+}
+static AUDIO_RAM int refill(struct cgd1_audio_decoder *d)
+{
+	if (d->offset >= d->size)
+		return 0;
+	if (d->cache_size && d->offset >= d->cache_offset
+		&& d->offset < d->cache_offset + d->cache_size)
+		return d->cache_size - (d->offset - d->cache_offset);
+	d->cache_offset = d->offset;
+	d->cache_size = d->size - d->offset;
+	if (d->cache_size > sizeof(d->cache))
+		d->cache_size = sizeof(d->cache);
+	if (d->read(d->context, d->offset, d->cache, d->cache_size))
+		return -1;
+	return d->cache_size;
+}
+AUDIO_RAM int cgd1_audio_decode16(struct cgd1_audio_decoder *d, uint16_t *out, unsigned count)
+{
+	unsigned n = 0;
+	while (n < count && d->frame < d->frames) {
+		if (d->pcm_pos == d->pcm_count) {
+			int available = refill(d);
+			if (available < 0)
+				return -1;
+			struct decoder_frame f;
+			memset(&f, 0, sizeof(f));
+			f.codec = d->codec;
+			f.rate = d->rate;
+			f.channels = 1;
+			f.state = d->state;
+			f.flags = DECODER_LEGACY_IMA;
+			f.input = d->cache + d->offset - d->cache_offset;
+			f.input_size = available;
+			f.output = d->pcm;
+			f.output_size = d->frames - d->frame;
+			if (f.output_size > CGD1_PCM_BUFFER)
+				f.output_size = CGD1_PCM_BUFFER;
+			int result = decode_frame(&f);
+			if (result == -2 && available && d->offset > d->cache_offset) {
+				/* A complete compressed frame can straddle cache windows. */
+				d->cache_size = 0;
+				continue;
+			}
+			if (result || !f.output_used || f.input_used > f.input_size)
+				return -1;
+			d->offset += f.input_used;
+			d->pcm_pos = 0;
+			d->pcm_count = f.output_used;
+		}
+		while (n < count && d->pcm_pos < d->pcm_count && d->frame < d->frames) {
+			out[n++] = (int32_t)d->pcm[d->pcm_pos++] + 32768;
+			d->frame++;
+		}
+	}
+	return n;
+}
+int cgd1_audio_decode(struct cgd1_audio_decoder *d, uint8_t *out, unsigned count)
+{
+	uint16_t sample;
+	unsigned n = 0;
+	while (n < count) {
+		int result = cgd1_audio_decode16(d, &sample, 1);
+		if (result < 0)
+			return -1;
+		if (!result)
+			break;
+		out[n++] = sample >> 8;
+	}
+	return n;
+}

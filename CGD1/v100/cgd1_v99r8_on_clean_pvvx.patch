+void cgd1_ui_show_all_segments_locked(void)
+
+{
+	cgd1_state.screen = 6;
+	cgd1_lcd_fill();
+	cgd1_display_flush();
+	cgd1_state.screen_locked = 1;
+	return;
+}
+
+void cgd1_ui_redraw(void)
+
+{
+	if (cgd1_state.screen_locked == '\0')
+	{
+		switch (cgd1_state.screen)
+		{
+		case 1:
+			cgd1_ui_show_clock();
+			break;
+		case 2:
+			cgd1_ui_show_non_snoozable_alarm();
+			break;
+		case 3:
+			cgd1_ui_show_snoozable_alarm();
+			break;
+		case 4:
+			cgd1_ui_show_snooze_wait();
+			break;
+		case 5:
+			cgd1_ui_show_next_alarm();
+		}
+	}
+	return;
+}

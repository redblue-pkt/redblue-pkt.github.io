+									 name]
+
+------------------------------------------------------------------------------
+ CAUTION [optional]
+ [State any special notes, constraints or cautions for users of this function]
+
+------------------------------------------------------------------------------
+*/
+
+void lsp_avg(
+	lsp_avgState *st,         /* i/o : State struct                 Q15 */
+	Word16 *lsp,              /* i   : state of the state machine   Q15 */
+	Flag   *pOverflow         /* o   : Flag set when overflow occurs    */
+)
+{
+	Word16 i;
+	Word32 L_tmp;            /* Q31 */
+
+	for (i = 0; i < M; i++)
+	{
+
+		/* mean = 0.84*mean */

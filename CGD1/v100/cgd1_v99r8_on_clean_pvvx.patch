+int cgd1_audio_open(struct cgd1_audio_decoder *d,
+	int (*read)(void *, uint32_t, uint8_t *, unsigned), void *context, uint32_t size)
+{
+	uint8_t h[24];
+	uint32_t bytes;
+	if (!size || !read)
+		return -1;
+	memset(d, 0, sizeof(*d));
+	d->read = read;
+	d->context = context;
+	d->size = size;
+	d->codec = AUDIO_PCM8;
+	d->rate = 8000;
+	d->frames = size;
+	if (size >= 4) {
+		if (read(context, 0, h, 4))
+			return -1;
+		if (!memcmp(h, "#!AM", 4)) {
+			if (open_framed(d, AUDIO_AMR))
+				return -1;
+		} else if (h[0] == 0x9c || h[0] == 0xad) {
+			if (open_framed(d, h[0] == 0xad ? AUDIO_MSBC : AUDIO_SBC)) {
+				if (d->frames)
+					return -1;
+				/* Untagged PCM8 may start with the same byte. */
+				d->codec = AUDIO_PCM8;
+				d->rate = 8000;
+				d->frames = size;
+				d->offset = d->cache_size = 0;
+			}
+		} else if (!memcmp(h, "CGDA", 4)) {
+			if (size < sizeof(h) || read(context, 0, h, sizeof(h)))
+				return -1;
+			d->codec = h[5];
+			d->rate = u32(h + 8);
+			d->frames = u32(h + 12);
+			bytes = u32(h + 16);
+			if (h[4] != 1 || h[6] != 1 || h[7] || (cgd1_crc32_update(0xffffffff, h, 20) ^ 0xffffffff) != u32(h + 20)
+				|| !d->frames || d->rate < 4000 || d->rate > DECODER_MAX_RATE
+				|| bytes != size - sizeof(h))
+				return -1;

+#define AUDIO_DECODER_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include "decoder_config.h"
+#define DECODER_INIT 1u
+#define DECODER_PROBE 2u
+#define DECODER_LEGACY_IMA 4u
+#define DECODER_RAM __attribute__((section(".ram_code")))
+enum audio_format {
+	AUDIO_PCM8 = 1,
+	AUDIO_PCM16 = 2,
+	AUDIO_IMA = 3,
+	AUDIO_ALAW = 4,
+	AUDIO_ULAW = 5,
+	AUDIO_G722 = 8,
+	AUDIO_AMR = 9,
+	AUDIO_SBC = 10,
+	AUDIO_MSBC = 11,
+	AUDIO_TELINK_SBC = 14
+};
+/* One mono stream. No allocation, resampling, channel mixing or hardware I/O.
+ * PROBE: 1 recognized, 0 other codec, -1 invalid settings.
+ * DECODE: 0 success, -1 corrupt frame, -2 insufficient input/output.
+ * input_used/output_used count bytes and signed PCM16 samples respectively. */
+struct decoder_frame {
+	void *state;
+	const uint8_t *input;
+	int16_t *output;
+	uint32_t rate;
+	unsigned input_size, output_size, input_used, output_used;
+	uint8_t codec, channels, flags;
+};

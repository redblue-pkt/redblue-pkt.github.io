+uint32_t cgd1_calendar_to_epoch(struct cgd1_calendar *date)
+{
+	rtc_time_t value;
+	value.year = date->year >= 2000 ? date->year - 2000 : date->year - 1900;
+	value.month = date->month;
+	value.days = date->day;
+	value.hours = date->hour;
+	value.minutes = date->minute;
+	value.seconds = date->second;
+	uint32_t epoch = rtc_to_utime(&value);
+	return date->year >= 2000 ? epoch : epoch - 3155760000u;
+}
+
+void cgd1_epoch_to_calendar(uint32_t epoch, struct cgd1_calendar *date)
+{
+	rtc_time_t value;
+	utime_to_rtc(epoch, &value);
+	date->year = value.year + (epoch >= 946684800u ? 2000 : 1744);
+	date->month = value.month;
+	date->day = value.days;
+	date->hour = value.hours;
+	date->minute = value.minutes;
+	date->second = value.seconds;
+}
+#else
+static const uint8_t month_days[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+static bool leap_year(uint32_t year)
+{
+	return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+}
+uint32_t cgd1_calendar_to_epoch(struct cgd1_calendar *date)
+{
+	uint32_t days = 0;
+	uint32_t year;
+	uint32_t month;
+	for (year = 1970; year < date->year; year++)
+	{
+		days += leap_year(year) ? 366 : 365;
+	}
+	for (month = 1; month < date->month; month++)
+	{
+		days += month_days[month - 1];
+		if (month == 2 && leap_year(date->year))
+		{
+			days++;
+		}
+	}
+	days += date->day - 1;
+	return (int)(days * 86400u + date->hour * 3600u + date->minute * 60u + date->second);
+}
+void cgd1_epoch_to_calendar(uint32_t epoch, struct cgd1_calendar *date)
+{
+	uint32_t days = epoch / 86400u;
+	uint32_t seconds = epoch % 86400u;
+	uint32_t year = 1970;
+	uint32_t month = 1;
+	uint32_t length;
+	while (days >= (length = leap_year(year) ? 366u : 365u))
+	{
+		days -= length;
+		year++;
+	}
+	for (;;)
+	{
+		length = month_days[month - 1];
+		if (month == 2 && leap_year(year))
+		{
+			length++;
+		}
+		if (days < length)
+		{
+			break;
+		}
+		days -= length;
+		month++;
+	}
+	date->year = year;
+	date->month = month;
+	date->day = days + 1;
+	date->hour = seconds / 3600u;
+	date->minute = seconds % 3600u / 60u;
+	date->second = seconds % 60u;
+}

+
+		int16 dither_seed;
+		int16 CN_dith;
+
+	} dtx_decState;
+
+	int16 dtx_enc_init(dtx_encState ** st, int16 isf_init[]);
+	int16 dtx_enc_reset(dtx_encState * st, int16 isf_init[]);
+	void dtx_enc_exit(dtx_encState ** st);
+

+#define AUDIO_RAM __attribute__((section(".ram_code")))
+static AUDIO_RAM int decode_frame(struct decoder_frame *f)
+{
+	switch (f->codec) {
+#if defined(DECODER_PCM8) || defined(DECODER_PCM16)
+#ifdef DECODER_PCM8
+	case AUDIO_PCM8:
+#endif
+#ifdef DECODER_PCM16
+	case AUDIO_PCM16:
+#endif
+		return libpcm_decode(f);
+#endif
+#if defined(DECODER_ADPCM)
+	case AUDIO_IMA:
+		return libadpcm_decode(f);
+#endif
+#if defined(DECODER_ALAW) || defined(DECODER_ULAW)
+#ifdef DECODER_ALAW
+	case AUDIO_ALAW:
+#endif
+#ifdef DECODER_ULAW
+	case AUDIO_ULAW:
+#endif
+		return libg711_decode(f);
+#endif
+#if defined(DECODER_G722)
+	case AUDIO_G722:
+		return libg722_decode(f);
+#endif
+#if defined(DECODER_AMR)
+	case AUDIO_AMR:
+		return libamr_decode(f);
+#endif
+#if defined(DECODER_SBC) || defined(DECODER_TSBC)
+#ifdef DECODER_SBC

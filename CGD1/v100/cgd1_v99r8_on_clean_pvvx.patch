+
+Word16 norm_l (Word32 L_var1)
+{
+	Word16 var_out;
+
+	if (L_var1 == 0)
+	{
+		var_out = 0;
+	}
+	else
+	{
+		if (L_var1 == (Word32) 0xffffffffL)
+		{
+			var_out = 31;
+		}
+		else
+		{
+			if (L_var1 < 0)
+			{
+				L_var1 = ~L_var1;
+			}
+			for (var_out = 0; L_var1 < (Word32) 0x40000000L; var_out++)
+			{
+				L_var1 <<= 1;
+			}
+		}
+	}
+

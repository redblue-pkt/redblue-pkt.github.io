+		dtx_encState * st,                    /* i/o : State struct                                         */
+		int16 isf[M],                        /* o   : CN ISF vector                                        */
+		int16 * exc2,                        /* o   : CN excitation                                        */
+		int16 ** prms
+	);
+
+	int16 dtx_buffer(
+		dtx_encState * st,                    /* i/o : State struct                    */
+		int16 isf_new[],                     /* i   : isf vector                      */
+		int32 enr,                           /* i   : residual energy (in L_FRAME)    */
+		int16 codec_mode
+	);

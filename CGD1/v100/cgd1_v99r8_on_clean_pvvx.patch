+
+void preemph_amrwb_dec(
+	int16 x[],         /* (i/o)   : input signal overwritten by the output */
+	int16 mu,          /* (i) Q15 : preemphasis coefficient                */
+	int16 lg           /* (i)     : lenght of filtering                    */
+)
+{
+	int16 i;
+	int32 L_tmp;

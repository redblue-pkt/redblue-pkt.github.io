+		L_tmp = L_msu(L_tmp, EXPCONST, st->lsp_meanSave[i], pOverflow);
+
+		/* Add 0.16 of newest LSPs to mean */
+		L_tmp = L_mac(L_tmp, EXPCONST, lsp[i], pOverflow);
+
+		/* Save means */
+		st->lsp_meanSave[i] = pv_round(L_tmp, pOverflow);   /* Q15 */
+	}
+
+	return;
+}

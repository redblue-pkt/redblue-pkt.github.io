+uint32_t cgd1_ui_show_next_alarm(void)
+
+{
+	uint32_t result = 0;
+
+	if (cgd1_state.screen_locked == '\0')
+	{
+		cgd1_state.screen = 5;
+		cgd1_lcd_snooze_label('\0', '\x03');
+		cgd1_lcd_stop_label('\0', '\x03');
+		cgd1_lcd_hide_sensor_values('\0');
+		result = cgd1_lcd_restore_date('\x01', '\0');
+	}
+	return result;

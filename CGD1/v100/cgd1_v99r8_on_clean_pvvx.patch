+/* Copyright (c) 2026, sakumisu. SPDX-License-Identifier: Apache-2.0
+ * Minimal mono decoder extracted from CherryAVP, commit
+ * 9829ff858aa3a3a1fb6706d598f6ca658f4b4e6a. No framework dependency. */
+#include "libpcm.h"
+#if defined(DECODER_PCM8) || defined(DECODER_PCM16)
+static int32_t pcm_read_sample(const uint8_t *sample, uint16_t bits)
+{
+	int32_t value;
+
+	if (bits == 8u) {
+		return ((int32_t)sample[0] - 128) * 256;
+	}
+	{
+		value = (int32_t)((uint32_t)sample[0] | ((uint32_t)sample[1] << 8));
+		return (int16_t)value;
+	}
+
+}
+
+int DECODER_RAM libpcm_decode(struct decoder_frame *f)
+{
+	if (!f)
+		return -1;
+	if (f->input_size && !f->input)
+		return -1;
+	if (!(f->flags & (DECODER_INIT | DECODER_PROBE)) && (!f->input || !f->output))
+		return -1;
+	unsigned bytes;
+	if (f->codec == AUDIO_PCM8)
+		bytes = 1;
+	else if (f->codec == AUDIO_PCM16)
+		bytes = 2;
+
+	else
+		return f->flags & DECODER_PROBE ? 0 : -1;
+	if (f->channels != 1 || f->rate < 4000 || f->rate > DECODER_MAX_RATE)
+		return -1;
+	if (f->flags & (DECODER_PROBE | DECODER_INIT))
+		return 1;
+	f->input_used = f->output_used = 0;
+	while (f->input_size - f->input_used >= bytes && f->output_used < f->output_size) {
+		f->output[f->output_used++] = pcm_read_sample(f->input + f->input_used, bytes * 8);
+		f->input_used += bytes;
+	}
+	return f->output_used ? 0 : -2;
+}
+#endif

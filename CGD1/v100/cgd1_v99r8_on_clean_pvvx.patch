+		s = L_shl (s, 3);
+		*yy++ = pv_round (s);
+	}
+
+	for (i = 0; i < lg; i++)
+	{
+		y[i] = tmp[i + M];
+	}
+
+	// Update of memory if update==1
+
+	if (update != 0)
+	{

+
+int16 Serial_parm(                        /* Return the parameter    */
+	int16 no_of_bits,                    /* input : number of bits  */
+	int16 ** prms
+)
+{
+	int16 value = 0;
+
+	for (int16 i = no_of_bits >> 1; i != 0; i--)
+	{
+		value <<= 2;
+
+		if (*((*prms)++) == BIT_1)
+		{
+			value |= 2;
+		}
+
+		if (*((*prms)++) == BIT_1)
+		{
+			value |= 1;
+		}
+
+	}
+
+	if (no_of_bits&1)
+	{
+		value <<= 1;
+
+		if (*((*prms)++) == BIT_1)
+		{
+			value |= 1;
+		}
+
+	}
+
+	return (value);
+}
+
+
+int16 Serial_parm_1bit(int16 ** prms)                 /* Return the parameter    */
+{
+	int16 value = 0;
+
+	if (*((*prms)++) == BIT_1)
+	{
+		value = 1;
+	}
+	return (value);
+}

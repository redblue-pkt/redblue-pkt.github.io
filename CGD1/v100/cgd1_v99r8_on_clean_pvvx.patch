+
+Word16 shr_r (Word16 var1, Word16 var2)
+{
+	Word16 var_out;
+
+	if (var2 > 15)
+	{
+		var_out = 0;
+	}
+	else
+	{
+		var_out = shr (var1, var2);
+#if (WMOPS)
+		multiCounter[currCounter].shr--;
+#endif
+
+		if (var2 > 0)
+		{
+			if ((var1 & ((Word16) 1 << (var2 - 1))) != 0)
+			{
+				var_out++;
+			}
+		}
+	}

+# Usage: make -f MakeCGD1 TC32_PATH=/absolute/path/to/tc32/bin/
+.DEFAULT_GOAL := cgd1
+.NOTPARALLEL:
+PROJECT_NAME := CGD1
+CGD1_DECODERS ?= PCM8 PCM16 ADPCM ALAW ULAW G722 SBC MSBC TSBC
+ifeq ($(strip $(CGD1_DECODERS)),)
+$(error Enable at least one audio decoder in CGD1_DECODERS)
+endif
+ifneq ($(filter-out PCM PCM8 PCM16 ADPCM G711 ALAW ULAW G722 AMR SBC MSBC TSBC,$(CGD1_DECODERS)),)
+$(error Unknown CGD1_DECODERS entry)
+endif
+CGD1_AMR := $(if $(filter AMR,$(CGD1_DECODERS)),1,0)
+POJECT_DEF := -DDEVICE_TYPE=58 -DCGD1_TELINK -DDECODER_CUSTOM $(addprefix -DDECODER_,$(CGD1_DECODERS))
+include makefile
+
+
+.PHONY: cgd1 cgd1-options
+cgd1: pre-build main-build
+$(OBJS): $(OUT_PATH)/cgd1.options $(wildcard src/decoders/*.h) src/cgd1/cgd1_audio.h src/cgd1/cgd1_internal.h src/cgd1/cgd1_app.h $(wildcard src/*.h src/cgd1/*.h)
+$(OUT_PATH)/cgd1.options: cgd1-options
+	@mkdir -p $(OUT_PATH)
+	@printf '%s\n' '$(GCC_FLAGS)' > $@.tmp
+	@cmp -s $@.tmp $@ || mv $@.tmp $@
+	@rm -f $@.tmp

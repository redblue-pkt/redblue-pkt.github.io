+	 Returns:
+		product = 32-bit product of the 32-bit L_var1 and 16-bit var1 (Word32)
+	*/
+
+	__inline Word32 Mpy_32_16(Word16 L_var1_hi,
+							  Word16 L_var1_lo,
+							  Word16 var2,
+							  Flag *pOverflow)
+	{
+
+		Word32 L_product;
+		Word32 L_sum;
+		Word32 result;
+		L_product = (Word32) L_var1_hi * var2;

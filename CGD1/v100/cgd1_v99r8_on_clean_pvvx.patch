+	extern const Word16 dico1_lsf_5[];
+	extern const Word16 dico2_lsf_5[];
+	extern const Word16 dico3_lsf_5[];
+	extern const Word16 dico4_lsf_5[];
+	extern const Word16 dico5_lsf_5[];

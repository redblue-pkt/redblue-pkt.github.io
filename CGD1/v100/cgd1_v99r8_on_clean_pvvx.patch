+void cgd1_ui_show_snooze_wait(void)
+
+{
+	if (cgd1_state.screen_locked == '\0')
+	{
+		cgd1_state.screen = 4;
+		cgd1_lcd_snooze_label('\0', '\x03');
+		cgd1_lcd_snooze_label('\x01', cgd1_state.config.chinese_language);
+		cgd1_lcd_stop_label('\0', '\x03');
+		cgd1_lcd_hide_sensor_values('\0');
+		cgd1_lcd_hide_date('\x01', '\x01');
+	}
+	return;
+}

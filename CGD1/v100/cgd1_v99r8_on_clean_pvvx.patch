+uint32_t cgd1_button_update_state(uint8_t level)
+{
+	struct cgd1_button_state *button = &cgd1_state.button;
+	button->level = level;
+	if (!level) {
+		if (button->previous_level == 1) {
+			cgd1_led_turn_on(0, cgd1_led_get_brightness());
+			if (!button->first_press_seen) {
+				button->first_press_seen = 1;
+				button->press_count = 1;
+				cgd1_key_first_press();
+			} else if (button->released_ticks < 50) {
+				button->press_count++;
+			}
+			button->pressed_ticks = 0;
+		}
+	} else if (!button->previous_level && level == 1) {
+		button->released_ticks = 0;
+	}
+	if (button->counted_presses + 1 < button->press_count) {
+		button->counted_presses = button->press_count;
+		cgd1_key_double_press();
+		if (button->counted_presses > 1)
+			button->multi_press_seen = 1;
+	}
+	if (button->level == 1 && button->released_ticks > 50 && button->press_count == 1) {
+		button->short_press_seen = 1;
+		cgd1_on_short_press();
+	}
+	bool released_hold = false;
+	if ((uint32_t)(button->pressed_ticks - 61) < 205) {
+		if (!button->hold_2_seconds_seen) {
+			cgd1_on_hold_2_seconds();
+			button->hold_2_seconds_seen = 1;
+		}
+		if (button->level == 1) {
+			button->short_press_seen = 1;
+			released_hold = true;
+		}
+	}
+	if (released_hold || button->level == 1) {
+		if (cgd1_state.next_mode)
+			cgd1_alarm_show_next(0);
+	} else if (!button->level && button->pressed_ticks >= 34 && button->pressed_ticks <= 65) {
+		if (!cgd1_state.config.alarms_all_off && cgd1_rtc_initialization_ready())
+			cgd1_alarm_show_next(1);
+	} else if (button->pressed_ticks >= 201 && cgd1_state.config.alarms_all_off == 1) {
+		if (cgd1_state.next_mode)
+			cgd1_alarm_show_next(0);
+	}
+	if (!button->level && button->pressed_ticks > 199) {
+		if (!button->hold_6_seconds_seen) {
+			button->hold_6_seconds_seen = 1;
+			cgd1_on_hold_6_seconds();
+			if (!cgd1_state.config.alarms_all_off)
+				cgd1_alarm_show_next(1);
+		}
+		if (!button->level && button->pressed_ticks >= 666 && !button->hold_20_seconds_seen) {
+			button->hold_20_seconds_seen = 1;
+			if (!button->short_press_seen) {
+				button->short_press_seen = 1;
+				cgd1_on_factory_reset();
+			}
+		}
+	}
+	if (button->level == 1 && (button->short_press_seen || button->hold_6_seconds_seen ||
+		button->hold_20_seconds_seen || button->released_ticks >= 57)) {
+		cgd1_on_press_sequence_finished();
+		button->scanning = 0;
+		button->first_press_seen = 0;
+		button->counted_presses = 0;
+		button->press_count = 0;
+		button->short_press_seen = 0;
+		button->hold_20_seconds_seen = 0;
+		button->hold_6_seconds_seen = 0;
+		button->hold_2_seconds_seen = 0;
+		button->multi_press_seen = 0;
+		button->pressed_ticks = 0;
+		button->released_ticks = 0;
+		button->scan_pending = 0;
+		button->wakeup_pending = 0;
+		cgd1_power_unlock(5);
+		cgd1_key_irq_rearm();
+		return 255;
+	}
+	if (!button->level)
+		button->pressed_ticks++;
+	else
+		button->released_ticks++;
+	button->previous_level = button->level;
+	return 0;
+}

+uint16_t cgd1_app_battery(uint16_t sample)
+{
+	if (!battery_average)
+		battery_average = sample;
+	if (battery_count < 5) {
+		battery_sum += sample;
+		battery_count++;
+	} else {
+		battery_average = battery_sum / battery_count;
+		battery_count = 0;
+		battery_sum = 0;
+	}
+	battery_percent = battery_average >= 3001 ? 100 : battery_average > 2200 ? (battery_average - 2200) >> 3 : 0;

+/* SBC mono decoder. Structure and constants checked against the Telink
+ * b85 SBC/mSBC archives. Bit allocation/filter math also follows BlueZ libsbc:
+ * Copyright (C) 2004-2010 Marcel Holtmann, Henryk Ploetz, Brad Midgley,
+ * Nokia Corporation. SPDX-License-Identifier: LGPL-2.1-or-later.
+ * Transport, encoder, SDM, heap allocation and stereo paths are omitted. */
+#include "sbc_internal.h"
+#if defined(DECODER_SBC) || defined(DECODER_MSBC) || defined(DECODER_TSBC)
+#include "sbc_tables.h"
+struct subband_state {
+	int32_t history[170];
+	int16_t offset[16];
+	uint8_t initialized;
+};
+typedef char decoder_state_fits[(sizeof(struct subband_state) <= 768) ? 1 : -1];
+static const int8_t loudness_offset[2][8] = {
+	{-2, 0, 0, 0, 0, 0, 0, 1},
+	{-3, 0, 0, 0, 0, 0, 1, 2}
+};
+static void allocate_bits(const uint8_t *scale, uint8_t *bits,
+	unsigned pool, unsigned frequency, unsigned snr)
+{
+	int need[8], maximum = 0, slice, count = 0, next = 0;
+	unsigned band;
+	for (band = 0; band < 8; band++) {
+		int value = scale[band] - loudness_offset[frequency][band];
+		need[band] = snr ? scale[band] : !scale[band] ? -5 : value > 0 ? value / 2 : value;
+		if (need[band] > maximum)
+			maximum = need[band];
+	}
+	slice = maximum + 1;
+	do {
+		slice--;
+		count += next;
+		next = 0;
+		for (band = 0; band < 8; band++) {
+			if (need[band] > slice + 1 && need[band] < slice + 16)
+				next++;
+			else if (need[band] == slice + 1)
+				next += 2;
+		}
+	} while (count + next < (int)pool);
+	if (count + next == (int)pool) {
+		count += next;
+		slice--;
+	}
+	for (band = 0; band < 8; band++) {
+		int width = need[band] < slice + 2 ? 0 : need[band] - slice;
+		bits[band] = width > 16 ? 16 : width;
+	}
+	for (band = 0; count < (int)pool && band < 8; band++) {
+		if (bits[band] >= 2 && bits[band] < 16) {
+			bits[band]++;
+			count++;
+		} else if (need[band] == slice + 1 && (int)pool > count + 1) {
+			bits[band] = 2;
+			count += 2;
+		}
+	}
+	for (band = 0; count < (int)pool && band < 8; band++) {
+		if (bits[band] < 16) {
+			bits[band]++;
+			count++;
+		}
+	}
+}
+static void synthesize(struct subband_state *state, const int32_t *samples, int16_t *output)
+{
+	unsigned row, band, tap;
+	for (row = 0; row < 16; row++) {
+		if (--state->offset[row] < 0) {
+			state->offset[row] = 159;
+			for (tap = 0; tap < 9; tap++)
+				state->history[160 + tap] = state->history[tap];
+		}
+		uint32_t sum = 0;
+		for (band = 0; band < 8; band++)
+			sum += (uint32_t)synthesis_matrix[row * 8 + band] * (uint32_t)samples[band];
+		state->history[state->offset[row]] = (int32_t)sum >> 15;
+	}
+	for (band = 0; band < 8; band++) {
+		uint32_t sum = 0;
+		unsigned even = state->offset[band], odd = state->offset[band + 8];
+		for (tap = 0; tap < 5; tap++) {
+			sum += (uint32_t)state->history[even + tap * 2] * (uint32_t)prototype_even[band * 5 + tap];
+			sum += (uint32_t)state->history[odd + tap * 2 + 1] * (uint32_t)prototype_odd[band * 5 + tap];
+		}
+		int32_t value = (int32_t)sum >> 15;
+		output[band] = value > 32767 ? 32767 : value < -32768 ? -32768 : value;
+	}
+}
+static uint8_t frame_crc(const uint8_t *data)
+{
+	uint8_t crc = 15;
+	unsigned byte, bit;
+	for (byte = 0; byte < 6; byte++) {
+		uint8_t value = data[byte < 2 ? byte + 1 : byte + 2];
+		for (bit = 0; bit < 8; bit++) {
+			uint8_t top = (crc ^ value) & 128;
+			crc <<= 1;
+			if (top)
+				crc ^= 0x1d;
+			value <<= 1;
+		}
+	}
+	return crc;
+}
+/* Exact division by 2^width-1 using end-around carries. The final
+ * quotient is below 2^20, so no 64-bit runtime/division is needed. */
+static uint32_t dequantize(unsigned value, unsigned shift, unsigned width)
+{
+	uint32_t odd = value * 2 + 1;
+	uint32_t low = odd << shift;
+	uint32_t high = odd >> (32 - shift);
+	uint32_t mask = (1u << width) - 1;
+	uint32_t part = (low >> width) | (high << (32 - width));
+	uint32_t quotient = part;
+	uint32_t remainder = (low & mask) + part;
+	while (remainder > mask) {
+		part = remainder >> width;
+		quotient += part;
+		remainder = (remainder & mask) + part;
+	}
+	return quotient + (remainder == mask);
+}
+int DECODER_RAM subband_decode(struct decoder_frame *f, uint8_t msbc)
+{
+	if (!f)
+		return -1;
+	if (f->input_size && !f->input)
+		return -1;
+	if (!(f->flags & (DECODER_INIT | DECODER_PROBE)) && (!f->input || !f->output))
+		return -1;
+	struct subband_state *state = f->state;
+	const uint8_t *data = f->input;
+	unsigned input_size = f->input_size;
+	uint8_t telink_frame[23];
+	unsigned blocks, pool, frequency = 0, snr = 0, length, band, block, bit = 64;
+	uint8_t scale[8], bits[8];
+	if (msbc ? f->codec != AUDIO_MSBC : (f->codec != AUDIO_SBC && f->codec != AUDIO_TELINK_SBC))
+		return f->flags & DECODER_PROBE ? 0 : -1;
+	if (!f->rate && !((f->flags & DECODER_PROBE) && f->input_size))
+		return -1;
+	if (f->channels != 1 || (f->rate && f->rate != 16000 && (msbc || f->rate != 32000)))
+		return -1;
+	if ((f->flags & DECODER_PROBE) && !f->input_size)
+		return f->rate ? 1 : -1;
+	if (!state && !(f->flags & DECODER_PROBE))
+		return -1;
+	if (f->flags & DECODER_INIT) {
+		memset(state, 0, sizeof(*state));
+		return 1;
+	}
+	f->input_used = f->output_used = 0;
+	if (f->codec == AUDIO_TELINK_SBC) {
+		if (input_size < 20)
+			return -2;
+		telink_frame[0] = 0x9c;
+		telink_frame[1] = 0x11;
+		telink_frame[2] = 12;
+		memcpy(telink_frame + 3, data, 20);
+		data = telink_frame;
+		input_size = sizeof(telink_frame);
+	}
+	if (input_size < 8)
+		return -2;
+	if (msbc) {
+		if (data[0] != 0xad || data[1] || data[2])
+			return -1;
+		blocks = 15;
+		pool = 26;
+		f->rate = 16000;
+	} else if (f->codec == AUDIO_TELINK_SBC) {
+		if (data[0] != 0x9c || f->rate != 16000)
+			return -1;
+		blocks = 10;
+		pool = 12;
+	} else {
+		uint8_t header = data[1];
+		frequency = header >> 6;
+		if (data[0] != 0x9c || frequency > 1 || (header & 12) || !(header & 1)
+			|| (f->rate && f->rate != (frequency ? 32000u : 16000u)))
+			return -1;
+		f->rate = frequency ? 32000 : 16000;
+		blocks = 4 * (((header >> 4) & 3) + 1);
+		snr = (header >> 1) & 1;
+		pool = data[2];
+		if (pool < 2 || pool > 128)
+			return -1;
+	}
+	length = 8 + (blocks * pool + 7) / 8;
+	if (input_size < length || (!(f->flags & DECODER_PROBE) && f->output_size < blocks * 8))
+		return -2;
+	if (frame_crc(data) != data[3])
+		return -1;
+	if (f->flags & DECODER_PROBE) {
+		f->input_used = f->codec == AUDIO_TELINK_SBC ? 20 : length;
+		f->output_used = blocks * 8;
+		return 1;
+	}
+	for (band = 0; band < 8; band++)
+		scale[band] = (data[4 + band / 2] >> ((band & 1) ? 0 : 4)) & 15;
+	allocate_bits(scale, bits, pool, frequency, snr);
+	if (!state->initialized) {
+		for (band = 0; band < 16; band++)
+			state->offset[band] = band * 10 + 10;
+		state->initialized = 1;
+	}
+	for (block = 0; block < blocks; block++) {
+		int32_t samples[8];
+		for (band = 0; band < 8; band++) {
+			unsigned width = bits[band], value = 0, n;
+			if (!width) {
+				samples[band] = 0;
+				continue;
+			}
+			for (n = 0; n < width; n++, bit++)
+				value = (value << 1) | ((data[bit >> 3] >> (7 - (bit & 7))) & 1);
+			unsigned shift = scale[band] + 3;
+			samples[band] = (int32_t)dequantize(value, shift, width) - (1u << shift);
+		}
+		synthesize(state, samples, f->output + block * 8);
+	}
+	f->input_used = f->codec == AUDIO_TELINK_SBC ? 20 : length;
+	f->output_used = blocks * 8;
+	return 0;
+}

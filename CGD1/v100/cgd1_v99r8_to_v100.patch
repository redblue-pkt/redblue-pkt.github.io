+		out[2] = 0;
+		return 3;
+	}
+	if (!stream_active()) {
+		out[2] = 2;
+		return 3;
+	}
+	if (sub == 0x32 && n > 4 && !stream.ended) {
+		u16 sequence = p[2] | (u16)p[3] << 8;
+		unsigned bytes = n - 4;
+		if (sequence != stream.sequence || bytes > CGD1_STREAM_CAPACITY - (stream.received - stream.consumed)
+			|| stream.received > 0xffff0000ul - bytes) {
+			stream_fail(4);
+			out[2] = 2;
+			return 3;
+		}
+		for (unsigned i = 0; i < bytes; i++)
+			stream.data[(stream.received + i) & (CGD1_STREAM_CAPACITY - 1)] = p[4 + i];
+		stream.received += bytes;
+		stream.sequence++;
+		stream_tick = clock_time();
+		return 0;
+	}
+	if (sub == 0x34 && n == 6) {
+		if (le32(p + 2) != stream.received)
+			return 3;
+		stream.ended = 1;
+		stream.state = 3;
+		stream_tick = clock_time();
+		out[2] = 0;
+	}
+	if (sub == 0x36 && n == 3 && p[2] <= 5) {
+		stream.volume = p[2];
+		audio_volume = p[2];
+		audio_gain = (u32)audio_volume * (audio_cycle_base >> 16) * 4096 / CGD1_AUDIO_PWM_PERIOD;
+		audio_neutral = audio_pwm_sample(32768);
+		audio_reference_cycle = audio_cycle_base | audio_neutral;
+		/* Already queued duty values drain in at most one ring duration. */
+		out[2] = 0;
+	}
+	return 3;

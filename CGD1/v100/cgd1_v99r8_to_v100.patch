+static void audio_enable(u32 period)
+{
+	gpio_set_func(GPIO_PC1, AS_PWM0);
+	gpio_set_func(GPIO_PC0, AS_PWM4_N);
+	/* Factory 0x13360: mode=3 at 0x800783, PWM4=0x05dc0280.
+	 * Factory 0x1466..0x149e restarts both channels for EVERY sample.
+	 * 0x0202 in its literal pool is GPIO_PC1, not a PWM compare value. */
+	/* main.c gates PWM off at boot. Register setup alone cannot run it. */
+	reg_clk_en0 |= FLD_CLK0_PWM_EN;
+	pwm_set_clk(CLOCK_SYS_CLOCK_HZ, CLOCK_SYS_CLOCK_HZ);
+	pwm_set_mode(PWM0_ID, PWM_IR_MODE);
+	pwm_set_pulse_num(PWM0_ID, 0);
+	/* Factory 0x133a4..0x133b2 sets bit 0 of 0x800784.
+	 * PC1 must be inverted relative to the PC0 PWM4_N reference. */
+	reg_pwm_invert = (reg_pwm_invert & ~BIT(4)) | BIT(0);
+	reg_pwm_n_invert &= ~BIT(4);
+	pwm_set_cycle_and_duty(PWM0_ID, period, audio_neutral);
+	pwm_set_cycle_and_duty(PWM4_ID, period, audio_neutral);

+/* Live protocol v1, PVVX command 0x90, subcommands 0x30..0x36.
+ * DATA has no success notification; STATUS confirms cumulative byte positions.
+ * Only this path touches the encoded RAM queue. Flash audio is unchanged. */
+static unsigned stream_command(u8 sub, const u8 *p, unsigned n, u8 *out)
+{
+	out[2] = 1;
+	if (sub == 0x30 && !n) {
+		out[2] = 0;
+		out[3] = 1;
+		put32(out + 4, CGD1_CODEC_MASK & ~(1ul << 9));
+		put32(out + 8, 16000);
+		out[12] = CGD1_STREAM_CAPACITY & 255;
+		out[13] = CGD1_STREAM_CAPACITY >> 8;
+		out[14] = 5;
+		out[15] = 1;
+		return 16;
+	}
+	if (sub == 0x31 && n == 8) {
+		u16 token = p[0] | (u16)p[1] << 8;
+		if (migration_pending || ringing || stream_active() || cgd1_transfer_busy()) {
+			out[2] = 2;
+			return 3;
+		}
+		if (!token || p[7] > 5 || cgd1_audio_stream_init(&decoder, p[2], le32(p + 3)))
+			return 3;
+		cgd1_stop_audio();
+		memset(&stream, 0, sizeof(stream));
+		stream.token = token;
+		stream.volume = p[7];
+		stream.state = 1;
+		stream_tick = clock_time();
+		preview_audio = 1;
+		beep_mode = pcm_mode = audio_eof = 0;
+		ring_read = ring_write = 0;
+		underruns = 0;
+		u32 period = CLOCK_SYS_CLOCK_HZ / 32000;
+		audio_volume = stream.volume;
+		audio_gain = (u32)audio_volume * period * 4096 / CGD1_AUDIO_PWM_PERIOD;
+		audio_cycle_base = period << 16;
+		audio_neutral = audio_pwm_sample(32768);
+		audio_reference_cycle = audio_cycle_base | audio_neutral;
+		bls_l2cap_requestConnParamUpdate(6, 12, 0, 400);
+		out[2] = 0;
+		return 3;
+	}
+	if (sub == 0x33 && !n) {
+		out[2] = 0;
+		out[3] = stream.state;
+		out[4] = stream.error;
+		out[5] = stream.token;
+		out[6] = stream.token >> 8;
+		put32(out + 7, stream.received);
+		put32(out + 11, stream.consumed);
+		out[15] = stream.volume;
+		put32(out + 16, underruns);
+		return 20;
+	}
+	if (n < 2 || (p[0] | (u16)p[1] << 8) != stream.token)

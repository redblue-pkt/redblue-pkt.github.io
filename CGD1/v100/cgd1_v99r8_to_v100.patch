+static void stream_fail(u8 error)
+{
+	cgd1_stop_audio();
+	stream.state = 4;
+	stream.error = error;
+}
+static void stream_service(void)
+{
+	if (!wrk.ble_connected || wrk.ota_is_working) {
+		stream_fail(1);
+		return;
+	}
+	if (clock_time_exceed(stream_tick, 10000000)) {
+		stream_fail(2);
+		return;
+	}
+	if (audio_foot_stop()) {
+		cgd1_stop_audio();
+		return;
+	}
+	if (!audio_running && !stream.ended && stream.received - stream.consumed < 512)
+		return;
+	for (unsigned chunk = 0; chunk < RING_SIZE / 128; chunk++) {
+		unsigned free = (ring_read - ring_write - 1) & (RING_SIZE - 1);
+		if (free < 128)
+			break;
+		unsigned bytes = stream.received - stream.consumed;
+		if (!bytes)
+			break;
+		if (bytes > sizeof(decoder.cache))
+			bytes = sizeof(decoder.cache);
+		for (unsigned i = 0; i < bytes; i++)
+			decoder.cache[i] = stream.data[(stream.consumed + i) & (CGD1_STREAM_CAPACITY - 1)];
+		unsigned used = 0;
+		int count = cgd1_audio_stream_decode(&decoder, decoder.cache, bytes,
+			&used, (int16_t *)source_samples, 128);
+		if (count < 0 || (!count && stream.ended)) {
+			stream_fail(3);
+			return;
+		}
+		if (!count)
+			break;
+		stream.consumed += used;
+		for (unsigned i = 0; i < (unsigned)count; i++)
+			ring[(ring_write + i) & (RING_SIZE - 1)] = audio_pwm_sample((int32_t)(int16_t)source_samples[i] + 32768);
+		__asm__ volatile ("" ::: "memory");
+		ring_write = (ring_write + count) & (RING_SIZE - 1);
+	}
+	unsigned queued = (ring_write - ring_read) & (RING_SIZE - 1);
+	if (audio_running && !stream.ended)
+		stream.state = queued ? 2 : 1;
+	if (!audio_running && queued >= (stream.ended ? 1 : 256)) {
+		audio_enable(audio_cycle_base >> 16);
+		stream.state = stream.ended ? 3 : 2;
+	}
+	if (stream.ended && stream.received == stream.consumed && !queued)
+		cgd1_stop_audio();

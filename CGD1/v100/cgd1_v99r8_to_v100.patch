+/* Live input uses the same decoder state and implementations as flash audio.
+ * No file scan, rewind, flash access or allocation occurs here. */
+int cgd1_audio_stream_init(struct cgd1_audio_decoder *d, unsigned codec, uint32_t rate)
+{
+	if (codec >= 32 || !(CGD1_CODEC_MASK & (1ul << codec)) || codec == AUDIO_AMR || rate != 16000)
+		return -1;
+	memset(d, 0, sizeof(*d));
+	d->codec = codec;
+	d->rate = rate;
+	return cgd1_audio_rewind(d);
+}
+int cgd1_audio_stream_decode(struct cgd1_audio_decoder *d, const uint8_t *input,
+	unsigned size, unsigned *used, int16_t *output, unsigned capacity)
+{
+	struct decoder_frame f;
+	memset(&f, 0, sizeof(f));
+	f.codec = d->codec;
+	f.rate = d->rate;
+	f.channels = 1;
+	f.state = d->state;
+	f.flags = DECODER_LEGACY_IMA;
+	f.input = input;
+	f.input_size = size;
+	f.output = output;
+	f.output_size = capacity;
+	int result = decode_frame(&f);
+	*used = f.input_used;
+	if (result == -2)
+		return 0;
+	if (result || f.rate != d->rate || f.input_used > size || f.output_used > capacity)
+		return -1;
+	return f.output_used;
+}

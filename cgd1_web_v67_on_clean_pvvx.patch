+		'<label>Snooze <input id="cgd1AlarmSnooze" type="checkbox" checked></label> ' +
+		'<label>Master <input id="cgd1AlarmMaster" type="checkbox" checked></label> ' +
+		'<button type="button" onclick="cgd1WriteAlarm()">Save alarm</button> ' +
+		'<button type="button" onclick="cgd1Call(5,new Uint8Array([1])).then(()=>addLog(\'Test playback started (uploaded PCM, or 1 kHz diagnostic tone if none is installed)\')).catch(e=>addLog(e.message))" title="Uploaded PCM, or diagnostic 1 kHz tone when no ringtone has been uploaded">Test sound</button> ' +
+		'<button type="button" onclick="cgd1Call(5,new Uint8Array([0])).then(()=>addLog(\'Sound stopped\')).catch(e=>addLog(e.message))">Stop</button><br>Days: ' +
+		'<label><input class="cgd1AlarmDay" type="checkbox" value="1" checked>Mon</label> <label><input class="cgd1AlarmDay" type="checkbox" value="2" checked>Tue</label> <label><input class="cgd1AlarmDay" type="checkbox" value="4" checked>Wed</label> <label><input class="cgd1AlarmDay" type="checkbox" value="8" checked>Thu</label> <label><input class="cgd1AlarmDay" type="checkbox" value="16" checked>Fri</label> <label><input class="cgd1AlarmDay" type="checkbox" value="32" checked>Sat</label> <label><input class="cgd1AlarmDay" type="checkbox" value="64" checked>Sun</label> ' +
+		'<label>Volume <select id="cgd1Volume"><option value="0">Mute</option><option value="1">1</option><option value="2" selected>2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option></select></label> <button type="button" onclick="cgd1SetVolume()">Apply audio/time</button> ' +
+		'<label>Ringtone <input id="cgd1PcmFile" type="file" accept="audio/*,.wav,.mp3,.ogg,.flac,.pcm,.raw"></label> <button id="cgd1UploadButton" type="button" onclick="cgd1UploadPcm()">Upload</button> <progress id="cgd1UploadProgress" max="100" value="0" hidden></progress> <span id="cgd1Status" role="status" aria-live="polite"></span>';
+}
+async function cgd1ReadAlarm() {
+	try {
+		let index = 0;
+		let r = await cgd1Call(3, new Uint8Array([index]));
+		$('cgd1AlarmEnabled').checked = !!r.getUint8(4);
+		$('cgd1AlarmTime').value = String(r.getUint8(5)).padStart(2,'0')+':'+String(r.getUint8(6)).padStart(2,'0');
+		let days = r.getUint8(7);
+		document.querySelectorAll('.cgd1AlarmDay').forEach(el => el.checked = !!(days & Number(el.value)));
+		$('cgd1AlarmSnooze').checked = !!r.getUint8(8);
+		addLog('CGD1 alarm slot '+(index+1)+' read');
+	} catch(error) { addLog('CGD1 alarm read: '+error.message); }
+}
+async function cgd1WriteAlarm() {
+	try {
+		const t = $('cgd1AlarmTime').value.split(':').map(Number);
+		if(t.length !== 2 || !Number.isInteger(t[0]) || !Number.isInteger(t[1]) || t[0] > 23 || t[1] > 59)
+			throw new Error('Enter an alarm time in 24-hour format');
+		let days = 0;
+		document.querySelectorAll('.cgd1AlarmDay:checked').forEach(el => days |= Number(el.value));
+		const enabled = $('cgd1AlarmEnabled').checked ? 1 : 0;
+		const master = $('cgd1AlarmMaster').checked ? 1 : 0;
+		const snooze = $('cgd1AlarmSnooze').checked ? 1 : 0;
+		await cgd1Call(4, new Uint8Array([0, enabled, t[0], t[1], days, snooze]));
+		await cgd1Call(7, new Uint8Array([1, master]));
+		const saved = await cgd1Call(3, new Uint8Array([0]));
+		const armed = await cgd1Call(7, new Uint8Array());
+		if(saved.getUint8(4) !== enabled || saved.getUint8(5) !== t[0] || saved.getUint8(6) !== t[1] ||
+			saved.getUint8(7) !== days || saved.getUint8(8) !== snooze || armed.getUint8(3) !== master)
+			throw new Error('Alarm readback differs from the requested settings');
+		const runtime = await cgd1Call(0x17, new Uint8Array());
+		if(enabled && master && !runtime.getUint8(3))
+			throw new Error('Date/time is invalid; use the existing Set Time button');
+		const next = runtime.getUint32(12, true);
+		const message = enabled && master ? 'Alarm saved and armed. Next: ' + PVVXClock.format(next).replace('T', ' ') : 'Alarm settings saved; alarm disabled';
+		$('cgd1Status').textContent = message;
+		addLog(message);
+	} catch(error) {
+		$('cgd1Status').textContent = 'Alarm: ' + error.message;
+		addLog('Alarm: ' + error.message);
+	}
+}
+async function cgd1SetAlarmMaster() {
+	try {
+		await cgd1Call(7, new Uint8Array([1, $('cgd1AlarmMaster').checked?1:0]));
+		addLog('CGD1 alarm master updated');
+	} catch(error) { addLog('CGD1 alarm master: '+error.message); }
+}
+async function cgd1ReadAlarmMaster() {
+	try {
+		let r = await cgd1Call(7, new Uint8Array());
+		$('cgd1AlarmMaster').checked = !!r.getUint8(3);
+	} catch(error) { addLog('CGD1 alarm master: '+error.message); }
+}
+async function cgd1ReadSettings() {
+	try {
+		let r = await cgd1Call(1, new Uint8Array());
+		$('cgd1Volume').value = r.getUint8(5);
+		$('cfg_flg_am_pm').checked = !!(r.getUint8(10) & 1);
+		$('cgd1AlarmMaster').checked = !(r.getUint8(10) & 2);
+	} catch(error) { addLog('CGD1 settings: '+error.message); }
+}
+async function cgd1StoreAudioSettings() {
+	const r = await cgd1Call(1, new Uint8Array());
+	const volume = Number($('cgd1Volume').value);
+	const h12 = $('cfg_flg_am_pm').checked ? 1 : 0;
+	await cgd1Call(2, new Uint8Array([r.getUint8(4), volume, r.getUint8(6), 0, 0, h12]));
+	const saved = await cgd1Call(1, new Uint8Array());
+	if(saved.getUint8(5) !== volume || (saved.getUint8(10) & 1) !== h12)
+		throw new Error('Audio/clock settings readback mismatch');
+}
+async function cgd1SetVolume() {
+	try {
+		await cgd1StoreAudioSettings();
+		$('cgd1Status').textContent = 'Volume and 12/24-hour format saved and verified';
+	} catch(error) {
+		$('cgd1Status').textContent = 'Settings FAILED: ' + error.message;
+	}
+}
+function cgd1Crc32(bytes) {
+	let crc = 0xffffffff;
+	for(let b of bytes) { crc ^= b; for(let i=0;i<8;i++) crc = (crc>>>1) ^ ((crc&1)?0xedb88320:0); }
+	return (crc ^ 0xffffffff) >>> 0;
+}
+let cgd1Uploading = false;
+async function cgd1DecodeAudio(file) {
+	const bytes = new Uint8Array(await file.arrayBuffer());
+	if(/\.(pcm|raw)$/i.test(file.name))
+		return bytes;
+	const Audio = window.AudioContext || window.webkitAudioContext;
+	const Offline = window.OfflineAudioContext || window.webkitOfflineAudioContext;
+	if(!Audio || !Offline)
+		throw new Error('Audio decoding unavailable; select unsigned PCM8 mono 8000 Hz (.pcm)');
+	const context = new Audio();
+	try {
+		const decoded = await context.decodeAudioData(bytes.buffer.slice(0));
+		const length = Math.ceil(decoded.duration * 8000);
+		if(!length || length > 0x18000)
+			throw new Error('Ringtone must be at most 12.288 seconds');
+		const offline = new Offline(1, length, 8000);
+		const source = offline.createBufferSource();
+		source.buffer = decoded;
+		source.connect(offline.destination);
+		source.start();
+		const rendered = await offline.startRendering();
+		const samples = rendered.getChannelData(0);
+		const pcm = new Uint8Array(samples.length);
+		for(let i = 0; i < pcm.length; i++)
+			pcm[i] = Math.max(0, Math.min(255, Math.round(128 + samples[i] * 127)));
+		return pcm;
+	} finally {
+		await context.close();
+	}
+}
+function cgd1TransferProgress(label, count, total) {
+	const percent = total ? Math.floor(count * 100 / total) : 0;
+	$('cgd1UploadProgress').hidden = false;
+	$('cgd1UploadProgress').value = percent;
+	$('cgd1Status').textContent = label + ': ' + percent + '% (' + count + '/' + total + ' B)';
+}
+async function cgd1WaitUpload(state, expectedBytes, label, total) {
+	const deadline = Date.now() + 45000;
+	while(Date.now() < deadline) {
+		const r = await cgd1Call(0x13, new Uint8Array());
+		const actual = r.getUint8(3);
+		if(actual === 5 || actual === 0)
+			throw new Error('Device aborted the transfer or CRC verification failed');
+		if(label)
+			cgd1TransferProgress(label, r.getUint32(state === 4 ? 13 : 9, true), total);
+		if(actual === state && !r.getUint8(4)) {
+			if(expectedBytes !== null && r.getUint32(5, true) !== expectedBytes)
+				throw new Error('Device received a different number of bytes');
+			return r;
+		}
+		await new Promise(resolve => setTimeout(resolve, 10));
+	}
+	throw new Error('Device transfer/verification timeout');
+}
+async function cgd1UploadPcm() {
+	if(cgd1Uploading)
+		return;
+	const file = $('cgd1PcmFile').files[0];
+	if(!file) {
+		$('cgd1Status').textContent = 'Select a ringtone file';
+		return;
+	}
+	cgd1Uploading = true;
+	$('cgd1UploadButton').disabled = true;
+	$('cgd1PcmFile').disabled = true;
+	try {
+		$('cgd1Status').textContent = 'Preparing audio…';
+		const pcm = await cgd1DecodeAudio(file);
+		if(!pcm.length || pcm.length > 0x18000 || String.fromCharCode(...pcm.slice(0, 4)) === 'RIFF')
+			throw new Error('Use audio up to 12.288 s, or unsigned PCM8 mono 8000 Hz up to 96 KiB');
+		let capabilities;
+		try {
+			capabilities = await cgd1Call(0x16, new Uint8Array());
+		} catch(error) {
+			throw new Error('Fast upload requires CGD1 firmware v67 or newer: ' + error.message);
+		}
+		if(capabilities.getUint8(3) !== 2 || capabilities.getUint8(4) !== 14 || capabilities.getUint16(5, true) !== 256)
+			throw new Error('Unsupported upload protocol');
+		const crc = cgd1Crc32(pcm);
+		await cgd1Call(0x10, cgd1Join(cgd1Le32(pcm.length), cgd1Le32(crc)));
+		await cgd1WaitUpload(2, 0, 'Erasing', Math.ceil(pcm.length / 4096) * 4096);
+		for(let offset = 0; offset < pcm.length;) {
+			const end = Math.min(pcm.length, offset + 256);
+			while(offset < end) {
+				const count = Math.min(14, end - offset);
+				const packet = cgd1Join(new Uint8Array([0x90, 0x15]), cgd1Le32(offset), pcm.slice(offset, offset + count));
+				if(typeof settingsCharacteristics.writeValueWithoutResponse === 'function')
+					await settingsCharacteristics.writeValueWithoutResponse(packet);
+				else
+					await settingsCharacteristics.writeValue(packet);
+				offset += count;
+			}
+			await cgd1WaitUpload(2, offset, null, pcm.length);
+			cgd1TransferProgress('Sending', offset, pcm.length);
+		}
+		await cgd1Call(0x12, new Uint8Array());
+		await cgd1WaitUpload(4, pcm.length, 'Verifying', pcm.length);
+		const active = await cgd1Call(1, new Uint8Array());
+		if(active.getUint32(11, true) !== pcm.length || active.getUint32(15, true) !== crc)
+			throw new Error('Active ringtone metadata does not match the file');
+		$('cgd1UploadProgress').value = 100;
+		$('cgd1Status').textContent = '100% — ringtone saved, CRC verified, active (' + pcm.length + ' B)';
+		addLog('Ringtone transfer OK; CRC32 ' + crc.toString(16).padStart(8, '0'));
+	} catch(error) {
+		$('cgd1Status').textContent = 'Transfer FAILED: ' + error.message;
+		addLog('Ringtone transfer FAILED: ' + error.message);
+	} finally {
+		cgd1Uploading = false;
+		$('cgd1UploadButton').disabled = false;
+		$('cgd1PcmFile').disabled = false;
+	}
+}

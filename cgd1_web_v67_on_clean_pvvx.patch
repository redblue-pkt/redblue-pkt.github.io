+function writeDevTime(time) {
+	return settingsCharacteristics.writeValue(PVVXClock.packet(time)).then(() => {
+		addAlog('Date/time sent (PVVX command 0x23)');
+		return settingsCharacteristics.writeValue(new Uint8Array([0x23]));
+	}).catch(error => addLog('Date/time error: ' + error));
+}
+function cgd1Call(sub, payload) {
+	if(!settingsCharacteristics) return Promise.reject(new Error('Device not connected'));
+	if(cgd1Replies.has(sub)) return Promise.reject(new Error('CGD1 command already pending'));
+	return new Promise((resolve, reject) => {
+		let timer = setTimeout(() => {
+			cgd1Replies.delete(sub);
+			reject(new Error('CGD1 command timeout 0x' + hex(sub, 2)));
+		}, 15000);
+		cgd1Replies.set(sub, {resolve, reject, timer});
+		let data = new Uint8Array(2 + (payload ? payload.length : 0));
+		data[0] = 0x90;
+		data[1] = sub;
+		if(payload) data.set(payload, 2);
+		settingsCharacteristics.writeValue(data).catch(error => {
+			clearTimeout(timer);
+			cgd1Replies.delete(sub);
+			reject(error);
+		});
 	});
 }
+function cgd1Le32(value) {
+	let data = new Uint8Array(4);
+	new DataView(data.buffer).setUint32(0, value >>> 0, true);
+	return data;
+}
+function cgd1Join(...parts) {
+	let size = parts.reduce((n, p) => n + p.length, 0), out = new Uint8Array(size), offset = 0;
+	for(let p of parts) { out.set(p, offset); offset += p.length; }
+	return out;
+}
+function cgd1AlarmPanel() {
+	return '<br>Alarm <label><input id="cgd1AlarmEnabled" type="checkbox"> on</label> ' +
